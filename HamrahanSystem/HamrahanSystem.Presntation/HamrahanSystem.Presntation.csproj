<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="wwwroot\assets\plugins\custom\bootstrap-duallistbox-master\demo\**" />
    <Content Remove="wwwroot\assets\plugins\custom\bootstrap-duallistbox-master\demo\**" />
