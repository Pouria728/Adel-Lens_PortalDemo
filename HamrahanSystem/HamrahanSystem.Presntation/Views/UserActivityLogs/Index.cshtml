@{
    ViewBag.Title = "";
    string BasePage = "UserActivityLogs";
}

<div class="card">
    <div class="card-header bg-primary"><h3 class="card-title align-items-start flex-column">گزارش فعالیت کاربران</h3> </div>
    <div class="card-body">
        <div class="form-group" id="divjqGrid">
            <table id="jqGrid" class="table table-striped"></table>
            <div id="jqGridPager"></div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function LoadDialog(correlationId) {
        var url = '@Url.Action("Details", BasePage)';
        $.get(url, { id: correlationId })
            .done(function (result) {
                $("#modal-loader").html(result);
                $("#modal-Tree").modal('show');
            }).fail(function () { toastr.error('خطا در بارگذاری جزئیات فعالیت', '') });
    }

    function LoadItems() {
        $('#modal-Tree').modal('hide');
        $.jgrid.defaults.responsive = true;
        $.jgrid.defaults.styleUI = 'Bootstrap';

        $('#jqGrid').jqGrid({
            url: '@Url.Action("Detail", BasePage)',
            datatype: 'json',
            mtype: 'POST',
            serializeGridData: function (postData) {
                var data = {};
                postData._search = true;
                data = $.extend(data, postData);
                return JSON.stringify(data);
            },
            colNames: ['شناسه', 'تاریخ', 'ساعت', 'کاربر', 'نوع اقدام', 'فرم', 'متد', 'وضعیت', 'مدت (ms)', '&#73;&#80;&#32;&#1593;&#1605;&#1608;&#1605;&#1740;', '&#73;&#80;&#32;&#1582;&#1589;&#1608;&#1589;&#1740;', ''],
            colModel: [
                { name: 'id', index: 'id', align: "Center", hidden: true, key: true, search: false },
                { name: 'createdDate', index: 'CreatedAt', align: "Center", sortable: true, search: false },
                { name: 'createdTime', index: 'CreatedAt', align: "Center", sortable: false, search: false },
                { name: 'userName', index: 'UserName', align: "Center", sortable: true, search: true },
                { name: 'actionType', index: 'ActionType', align: "Center", sortable: true, search: false },
                { name: 'formName', index: 'FormName', align: "Center", sortable: false, search: false },
                { name: 'httpMethod', index: 'HttpMethod', align: "Center", sortable: false, search: false },
                { name: 'statusText', index: 'StatusCode', align: "Center", sortable: false, search: false },
                { name: 'durationMs', index: 'DurationMs', align: "Center", sortable: false, search: false },
                { name: 'ipPublic', index: 'IpAddress', align: "Center", sortable: false, search: false },
                { name: 'ipPrivate', index: 'IpAddress', align: "Center", sortable: false, search: false },
                {
                    name: 'correlationId', index: 'Action', align: "Center", sortable: false, search: false,
                    formatter: function (value) {
                        return '<button type="button" title="جزئیات" onclick="LoadDialog(\'' + value + '\');"><i class="fa fa-2x fa-eye"></i></button>';
                    }
                }
            ],
            rowNum: 20,
            toppager: true,
            height: 300,
            direction: 'rtl',
            rowList: [10, 20, 30, 40],
            viewrecords: true,
            gridview: true,
            altRows: true,
            hidegrid: false,
            rownumbers: true,
            recordpos: 'left',
            multiselect: false,
            scroll: true,
            scrollrows: false,
            jsonReader: {
                page: function (obj) { return obj.page; },
                total: function (obj) { return obj.total; },
                records: function (obj) { return obj.records; },
                root: function (obj) { return obj.rows; },
                repeatitems: false,
                id: "0"
            },
            pager: "#jqGridPager",
            caption: 'گزارش فعالیت کاربران'
        });

        $('#jqGrid').trigger('reloadGrid');
        $(document).resize();
    }

    $(function () {
        LoadItems();
    });
</script>
