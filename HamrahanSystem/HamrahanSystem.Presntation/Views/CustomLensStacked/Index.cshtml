@model HamrahanSystem.Presntation.Models.CustomLensStackedViewModel
@using System.Text.Json

@{
    ViewBag.Title = "نمای یکجا (سفارشی)";
    var rows = Model?.Rows ?? new List<HamrahanSystem.Presntation.Models.CustomLensStackedRowViewModel>();
    var brandCount = rows.Select(x => x.BrandId).Distinct().Count();
    var lensTypeCount = rows.Select(x => x.LensTypeId).Distinct().Count();
    var designCount = rows.Select(x => x.DesignTypeId).Distinct().Count();
    var materialCount = rows.Where(x => x.MaterialId > 0).Select(x => x.MaterialId).Distinct().Count();
}

<style>
    .custom-lens-overview {
        --clo-bg: #f5f7fc;
        --clo-surface: #ffffff;
        --clo-border: #e2e8f5;
        --clo-title: #16213d;
        --clo-muted: #6b7a99;
        --clo-primary: #2f80ed;
        --clo-primary-dark: #1f60c7;
        --clo-success: #11a96b;
        --clo-danger: #d9534f;
        --clo-shadow: 0 16px 40px rgba(17, 29, 63, 0.08);
        direction: rtl;
    }

    .custom-lens-overview .clo-card {
        background: var(--clo-surface);
        border: 1px solid var(--clo-border);
        border-radius: 16px;
        box-shadow: var(--clo-shadow);
    }

    .custom-lens-overview .clo-header {
        padding: 1.2rem 1.3rem;
        background: linear-gradient(120deg, var(--clo-primary), var(--clo-primary-dark));
        color: #fff;
        border-radius: 16px;
    }

    .custom-lens-overview .clo-header h2 {
        margin: 0 0 .25rem;
        font-size: 1.25rem;
        font-weight: 800;
        color: #fff;
    }

    .custom-lens-overview .clo-header p {
        margin: 0;
        font-size: .86rem;
        color: rgba(255, 255, 255, .92);
    }

    .custom-lens-overview .clo-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .75rem;
        margin-top: 1rem;
    }

    .custom-lens-overview .clo-stat {
        border: 1px solid rgba(255, 255, 255, .35);
        border-radius: 12px;
        padding: .55rem .7rem;
        background: rgba(255, 255, 255, .14);
        text-align: center;
    }

    .custom-lens-overview .clo-stat strong {
        display: block;
        font-size: 1.08rem;
        line-height: 1.25;
        color: #fff;
        font-weight: 800;
    }

    .custom-lens-overview .clo-stat span {
        font-size: .72rem;
        color: rgba(255, 255, 255, .9);
    }

    .custom-lens-overview .clo-filters {
        padding: 1rem 1.1rem;
        margin-top: 1rem;
    }

    .custom-lens-overview .clo-label {
        font-size: .77rem;
        color: var(--clo-muted);
        margin-bottom: .3rem;
        display: block;
    }

    .custom-lens-overview .form-control,
    .custom-lens-overview .form-select {
        border-radius: 10px;
        border: 1px solid var(--clo-border);
        min-height: 40px;
        color: var(--clo-title);
    }

    .custom-lens-overview .form-control:focus,
    .custom-lens-overview .form-select:focus {
        border-color: #91baf5;
        box-shadow: 0 0 0 .2rem rgba(47, 128, 237, .12);
    }

    .custom-lens-overview .clo-table-wrap {
        margin-top: 1rem;
        border: 1px solid #d8e2f3;
        border-radius: 14px;
        background: #f8fbff;
        padding: .45rem;
        overflow: hidden;
    }

    .custom-lens-overview .clo-table-wrap .table-responsive {
        border: 1px solid #e1e9f7;
        border-radius: 12px;
        background: #fff;
        overflow: auto;
    }

    .custom-lens-overview .table {
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
        --bs-table-bg: transparent;
        --bs-table-border-color: #edf1f8;
    }

    .custom-lens-overview .table thead th {
        background: #f4f7fd;
        color: #21345f;
        font-size: .76rem;
        font-weight: 800;
        padding: .72rem .65rem;
        border-bottom-width: 1px;
        border-inline-end: 1px solid #e6edf9;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    .custom-lens-overview .table tbody td {
        color: #233155;
        font-size: .8rem;
        padding: .62rem .65rem;
        vertical-align: middle;
        border-color: #eef2f9;
        border-inline-end: 1px solid #f0f4fb;
    }

    .custom-lens-overview .table thead th:first-child,
    .custom-lens-overview .table tbody td:first-child {
        border-inline-start: 1px solid #dfe7f7;
        width: 56px;
        min-width: 56px;
        text-align: center;
        padding-inline: .65rem !important;
    }

    .custom-lens-overview .table thead th:last-child,
    .custom-lens-overview .table tbody td:last-child {
        border-inline-end: 1px solid #dfe7f7;
    }

    .custom-lens-overview .table tbody tr:hover {
        background: #f8fbff;
    }

    .custom-lens-overview .clo-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: .2rem .5rem;
        font-size: .69rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .custom-lens-overview .clo-badge-yes {
        color: #0f7c4f;
        background: #daf7eb;
        border: 1px solid #afebcf;
    }

    .custom-lens-overview .clo-badge-no {
        color: #a33838;
        background: #fde9e9;
        border: 1px solid #f7cbcb;
    }

    .custom-lens-overview .clo-cell-muted {
        color: #7c8cab;
    }

    .custom-lens-overview .clo-empty {
        padding: 2rem 1rem;
        text-align: center;
        color: #7f8ca8;
    }

    .custom-lens-overview .clo-compact {
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        display: inline-block;
        vertical-align: bottom;
    }

    @@media (max-width: 1199.98px) {
        .custom-lens-overview .clo-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        .custom-lens-overview .clo-stats {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="custom-lens-overview">
    <div class="clo-header clo-card">
        <h2>نمای یکجا (سفارشی)</h2>
        <p>نمای ترکیبی و حرفه‌ای از زنجیره تعریف پایه عدسی سفارشی بر اساس داده‌های ثبت‌شده.</p>
        <div class="clo-stats">
            <div class="clo-stat">
                <strong id="statRows">@rows.Count</strong>
                <span>ردیف قابل نمایش</span>
            </div>
            <div class="clo-stat">
                <strong id="statBrands">@brandCount</strong>
                <span>Brand</span>
            </div>
            <div class="clo-stat">
                <strong id="statLensTypes">@lensTypeCount</strong>
                <span>Lens Type</span>
            </div>
            <div class="clo-stat">
                <strong id="statDesigns">@designCount</strong>
                <span>Design Type</span>
            </div>
        </div>
    </div>

    <div class="clo-card clo-filters">
        <div class="row g-3">
            <div class="col-12 col-md-6 col-xl-2">
                <label class="clo-label" for="filterBrand">Brand</label>
                <select id="filterBrand" class="form-select"></select>
            </div>
            <div class="col-12 col-md-6 col-xl-2">
                <label class="clo-label" for="filterLensType">Lens Type</label>
                <select id="filterLensType" class="form-select"></select>
            </div>
            <div class="col-12 col-md-6 col-xl-2">
                <label class="clo-label" for="filterDesignType">Design Type</label>
                <select id="filterDesignType" class="form-select"></select>
            </div>
            <div class="col-12 col-md-6 col-xl-2">
                <label class="clo-label" for="filterLensIndex">Lens Index</label>
                <select id="filterLensIndex" class="form-select"></select>
            </div>
            <div class="col-12 col-md-6 col-xl-2">
                <label class="clo-label" for="filterMaterial">Material</label>
                <select id="filterMaterial" class="form-select"></select>
            </div>
            <div class="col-12 col-md-6 col-xl-2">
                <label class="clo-label" for="filterSearch">جستجو</label>
                <input id="filterSearch" type="text" class="form-control" placeholder="جستجو در کل جدول..." />
            </div>
        </div>
    </div>

    <div class="clo-card clo-table-wrap">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Brand</th>
                        <th>Lens Type</th>
                        <th>Design Type</th>
                        <th>Lens Index</th>
                        <th>Material</th>
                        <th>Coating</th>
                        <th>Addition</th>
                        <th>Corridor</th>
                        <th>Coloring Type</th>
                        <th>Inventory</th>
                    </tr>
                </thead>
                <tbody id="overviewTableBody"></tbody>
            </table>
        </div>
        <div id="overviewEmptyState" class="clo-empty d-none">هیچ موردی با فیلترهای انتخاب‌شده یافت نشد.</div>
    </div>
</div>

<script type="text/javascript">
    (function () {
        const data = @Html.Raw(JsonSerializer.Serialize(rows.Select(x => new
        {
            brandId = x.BrandId,
            brandName = x.BrandName,
            lensTypeId = x.LensTypeId,
            lensTypeName = x.LensTypeName,
            designTypeId = x.DesignTypeId,
            designTypeName = x.DesignTypeName,
            lensIndexId = x.LensIndexId,
            lensIndexName = x.LensIndexName,
            materialId = x.MaterialId,
            materialName = x.MaterialName,
            coatings = x.Coatings,
            additions = x.Additions,
            isCorridor = x.IsCorridor,
            hasColoringType = x.HasColoringType,
            defineObjectId = x.DefineObjectId
        })));

        const controls = {
            brand: document.getElementById("filterBrand"),
            lensType: document.getElementById("filterLensType"),
            designType: document.getElementById("filterDesignType"),
            lensIndex: document.getElementById("filterLensIndex"),
            material: document.getElementById("filterMaterial"),
            search: document.getElementById("filterSearch")
        };

        const tableBody = document.getElementById("overviewTableBody");
        const emptyState = document.getElementById("overviewEmptyState");

        const stats = {
            rows: document.getElementById("statRows"),
            brands: document.getElementById("statBrands"),
            lensTypes: document.getElementById("statLensTypes"),
            designs: document.getElementById("statDesigns")
        };

        const state = {
            brandId: "",
            lensTypeId: "",
            designTypeId: "",
            lensIndexId: "",
            materialId: "",
            search: ""
        };

        function escapeHtml(value) {
            const map = { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" };
            return String(value ?? "").replace(/[&<>"']/g, ch => map[ch]);
        }

        function distinctOptions(source, idKey, labelKey) {
            const seen = new Set();
            const options = [];
            source.forEach(item => {
                const id = item[idKey];
                const label = item[labelKey];
                if (id === null || id === undefined || label === null || label === undefined || label === "") {
                    return;
                }
                if (seen.has(id)) {
                    return;
                }
                seen.add(id);
                options.push({ id: String(id), label: String(label) });
            });
            options.sort((a, b) => a.label.localeCompare(b.label, "en", { sensitivity: "base" }));
            return options;
        }

        function setSelectOptions(selectElement, options, selectedValue, placeholder) {
            const current = selectedValue || "";
            const html = [`<option value="">${placeholder}</option>`]
                .concat(options.map(o => `<option value="${escapeHtml(o.id)}">${escapeHtml(o.label)}</option>`))
                .join("");
            selectElement.innerHTML = html;
            if (current && options.some(o => o.id === current)) {
                selectElement.value = current;
            } else {
                selectElement.value = "";
            }
        }

        function chainFilteredData() {
            const byBrand = state.brandId ? data.filter(x => String(x.brandId) === state.brandId) : data;
            const byLensType = state.lensTypeId ? byBrand.filter(x => String(x.lensTypeId) === state.lensTypeId) : byBrand;
            const byDesign = state.designTypeId ? byLensType.filter(x => String(x.designTypeId) === state.designTypeId) : byLensType;
            const byIndex = state.lensIndexId ? byDesign.filter(x => String(x.lensIndexId) === state.lensIndexId) : byDesign;
            return state.materialId ? byIndex.filter(x => String(x.materialId) === state.materialId) : byIndex;
        }

        function applySearch(source) {
            if (!state.search) {
                return source;
            }
            const q = state.search.toLowerCase();
            return source.filter(row =>
                (row.brandName || "").toLowerCase().includes(q) ||
                (row.lensTypeName || "").toLowerCase().includes(q) ||
                (row.designTypeName || "").toLowerCase().includes(q) ||
                (row.lensIndexName || "").toLowerCase().includes(q) ||
                (row.materialName || "").toLowerCase().includes(q) ||
                (row.coatings || "").toLowerCase().includes(q) ||
                (row.additions || "").toLowerCase().includes(q) ||
                String(row.defineObjectId || "").includes(q)
            );
        }

        function renderRows(rowsToRender) {
            if (!rowsToRender.length) {
                tableBody.innerHTML = "";
                emptyState.classList.remove("d-none");
                return;
            }

            emptyState.classList.add("d-none");

            tableBody.innerHTML = rowsToRender.map((row, idx) => {
                const corridorBadge = row.isCorridor
                    ? '<span class="clo-badge clo-badge-yes">فعال</span>'
                    : '<span class="clo-badge clo-badge-no">غیرفعال</span>';

                const coloringBadge = row.hasColoringType
                    ? '<span class="clo-badge clo-badge-yes">دارد</span>'
                    : '<span class="clo-badge clo-badge-no">ندارد</span>';

                const inventoryText = row.defineObjectId ? `#${escapeHtml(row.defineObjectId)}` : "-";

                return `
                    <tr>
                        <td>${idx + 1}</td>
                        <td>${escapeHtml(row.brandName)}</td>
                        <td>${escapeHtml(row.lensTypeName)}</td>
                        <td>${escapeHtml(row.designTypeName)}</td>
                        <td>${escapeHtml(row.lensIndexName)}</td>
                        <td>${escapeHtml(row.materialName)}</td>
                        <td><span class="clo-compact" title="${escapeHtml(row.coatings || "-")}">${escapeHtml(row.coatings || "-")}</span></td>
                        <td><span class="clo-compact" title="${escapeHtml(row.additions || "-")}">${escapeHtml(row.additions || "-")}</span></td>
                        <td>${corridorBadge}</td>
                        <td>${coloringBadge}</td>
                        <td class="clo-cell-muted">${inventoryText}</td>
                    </tr>`;
            }).join("");
        }

        function updateStats(rowsToRender) {
            stats.rows.textContent = String(rowsToRender.length);
            stats.brands.textContent = String(new Set(rowsToRender.map(x => x.brandId)).size);
            stats.lensTypes.textContent = String(new Set(rowsToRender.map(x => x.lensTypeId)).size);
            stats.designs.textContent = String(new Set(rowsToRender.map(x => x.designTypeId)).size);
        }

        function syncOptions() {
            const baseRows = state.brandId ? data.filter(x => String(x.brandId) === state.brandId) : data;
            const lensRows = state.lensTypeId ? baseRows.filter(x => String(x.lensTypeId) === state.lensTypeId) : baseRows;
            const designRows = state.designTypeId ? lensRows.filter(x => String(x.designTypeId) === state.designTypeId) : lensRows;
            const indexRows = state.lensIndexId ? designRows.filter(x => String(x.lensIndexId) === state.lensIndexId) : designRows;

            setSelectOptions(controls.brand, distinctOptions(data, "brandId", "brandName"), state.brandId, "همه Brand ها");
            setSelectOptions(controls.lensType, distinctOptions(baseRows, "lensTypeId", "lensTypeName"), state.lensTypeId, "همه Lens Type ها");
            setSelectOptions(controls.designType, distinctOptions(lensRows, "designTypeId", "designTypeName"), state.designTypeId, "همه Design Type ها");
            setSelectOptions(controls.lensIndex, distinctOptions(designRows, "lensIndexId", "lensIndexName"), state.lensIndexId, "همه Lens Index ها");
            setSelectOptions(controls.material, distinctOptions(indexRows, "materialId", "materialName"), state.materialId, "همه Material ها");

            state.brandId = controls.brand.value;
            state.lensTypeId = controls.lensType.value;
            state.designTypeId = controls.designType.value;
            state.lensIndexId = controls.lensIndex.value;
            state.materialId = controls.material.value;
        }

        function refresh() {
            syncOptions();
            const filtered = applySearch(chainFilteredData());
            renderRows(filtered);
            updateStats(filtered);
        }

        controls.brand.addEventListener("change", () => {
            state.brandId = controls.brand.value;
            state.lensTypeId = "";
            state.designTypeId = "";
            state.lensIndexId = "";
            state.materialId = "";
            refresh();
        });

        controls.lensType.addEventListener("change", () => {
            state.lensTypeId = controls.lensType.value;
            state.designTypeId = "";
            state.lensIndexId = "";
            state.materialId = "";
            refresh();
        });

        controls.designType.addEventListener("change", () => {
            state.designTypeId = controls.designType.value;
            state.lensIndexId = "";
            state.materialId = "";
            refresh();
        });

        controls.lensIndex.addEventListener("change", () => {
            state.lensIndexId = controls.lensIndex.value;
            state.materialId = "";
            refresh();
        });

        controls.material.addEventListener("change", () => {
            state.materialId = controls.material.value;
            refresh();
        });

        controls.search.addEventListener("input", () => {
            state.search = controls.search.value.trim();
            const filtered = applySearch(chainFilteredData());
            renderRows(filtered);
            updateStats(filtered);
        });

        refresh();
    })();
</script>
