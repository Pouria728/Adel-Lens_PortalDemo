          }
           if (props.status === 403) {
            toastr.warning(' به این قسمت دسترسی ندارید ','دسترسی');
          }
            });

                });

                function datepicker()
                    {
                    var dir = $('body').css('direction')
                    $('.DatePicker').persianDatepicker({
                        calendar: {
                            persian: {
                                leapYearMode: "astronomical"
                            }
                        },

                        responsive: true,
                        altFormat: 'LLLL',
                        initialValue: false,
                        observer: true,
                        format: 'YYYY/MM/DD',
                        calendarType: dir == 'rtl' ? 'persian' : 'gregorian',
                        timePicker: {
                            enabled: false
                        },
                        toolbox: {
                            calendarSwitch: {
                                enabled: false
                            }
                        }
                    });

                    $('.TimePicker').persianDatepicker({

                        responsive: true,
                        calendarType: 'gregorian',
                        //calendar: {
                        //    persian: {
                        //        locale: 'en'
                        //    }
                        //},
                        onlyTimePicker: true,
                        timePicker: {
                            meridian: {
                                enabled: true
                            },
                            second: {
                                enabled: false
                            }
                        },
                        format: 'HH:mm:ss'
                    });
                          $('.DateTimePicker').persianDatepicker({

                        calendar: {
                            persian: {
                                leapYearMode: "astronomical"
                            }
                        },

                        responsive: true,
                        altFormat: 'LLLL',
                        initialValue: false,
                        observer: true,
                        format: 'YYYY/MM/DD HH:mm:ss',
                        calendarType: dir == 'rtl' ? 'persian' : 'gregorian',
                        toolbox: {
                            calendarSwitch: {
                                enabled: false
                            }
                        },
                        timePicker: {
                            enabled:true,
                            meridian: {
                                enabled: true
                            },
                            second: {
                                enabled: false
                            }
                        },

                    });
                }

    </script>
