@model HamrahanSystem.Application.DTOs.TblLnsOrderDto
@{
    ViewBag.Title = "";
    string BasePage = "Orders";
}



<div class="card">
    <div class="card-header bg-primary"><h3 class="card-title align-items-start flex-column">@ResourcePages.OrderStock </h3> </div>
    <div class="card-body ltr">


        <!--begin::Form-->
        @* <form action="" id="kt_invoice_form"> *@
        <div id="kt_invoice_form">
            <!--begin::Wrapper-->
