        font-size: 11px;
        font-weight: 700;
        color: #56698d;
        letter-spacing: 0.2px;
        text-align: center;
        line-height: 1.2;
        margin-bottom: 6px !important;
    }

    .orderstock-inline-label {
        font-size: 11px;
        font-weight: 700;
        color: #56698d;
        letter-spacing: 0.2px;
        line-height: 1.2;
        margin: 0;
        white-space: nowrap;
    }

    .orderstock-qty-wrap {
        margin-top: 17px;
    }

    .orderstock-quantity-input {
        width: 90px;
        max-width: 90px;
    }

    .orderstock-tools-group {
        margin-left: 18px;
    }

    #modal-OrderCyl .cyl-grid-wrap {
