<script type="text/javascript">
    var testQuentity=0;
    function getLensTotal() {
        var total = 0;
        $('#kt_invoice_form2 [data-kt-element="items"] tbody [data-kt-element="item"]').each(function () {
            var value = $(this).find('[data-kt-element="quantityid"]').val();
            if (value === undefined || value === null) {
                return;
            }
            var normalized = value.toString().replace(/,/g, '').trim();
            var count = parseInt(normalized, 10);
            if (!isNaN(count)) {
                total += count;
            }
        });
        return total;
    }

    function updateLensTotal() {
        var total = getLensTotal();
        $('[data-kt-element="lens-total"]').text(total);
        return total;
    }

    function PreviewOrder() {
        var $modal = $('#modal-OrderPreview');
        if ($modal.length === 0) {
            return;
        }

        var normalizePreviewText = function (value) {
            var text = (value || '').toString().trim();
            return text ? text : '--';
        };

        var getSelectText = function ($select) {
            if (!$select || $select.length === 0) {
                return '';
            }
            var selectedValue = $select.val();
            if (selectedValue === undefined || selectedValue === null || selectedValue === '') {
                return '';
            }
            if ($select.data('select2')) {
                var data = $select.select2('data');
                if (data && data.length > 0 && data[0].text !== undefined) {
                    return data[0].text;
                }
            }
            var option = $select.find('option:selected');
            return option.length ? option.text() : '';
        };

        var setPreviewText = function (key, value) {
            $modal.find('[data-preview="' + key + '"]').text(normalizePreviewText(value));
        };

        var customerPreviewText = String($('#DefineCustomerSearch').val() || '').trim();
        if (!customerPreviewText) {
            var customerId = String($('#DefineCustomerId').val() || '').trim();
            if (customerId && Array.isArray(ListCustomer)) {
                var selectedCustomer = ListCustomer.find(function (item) {
                    if (!item || typeof item !== 'object') {
                        return false;
                    }
                    var itemId = String(item.defineCustomerId ?? item.DefineCustomerId ?? item.id ?? '').trim();
                    return itemId === customerId;
                });
                if (selectedCustomer) {
                    customerPreviewText = String(selectedCustomer.nameFormal ?? selectedCustomer.NameFormal ?? selectedCustomer.text ?? '').trim();
                }
            }
        }

        setPreviewText('customer', customerPreviewText);
        setPreviewText('description', $('[name="Description"]').val());

        var $tbody = $modal.find('[data-preview="items-body"]');
        $tbody.empty();

        var findField = function (row, key) {
            return row.querySelector('[data-kt-element="' + key + '"], [data_kt_element="' + key + '"]');
        };

        var getFieldText = function (row, key) {
            var el = findField(row, key);
            if (!el) {
                return '';
            }
            if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
                return el.value;
            }
            return el.textContent;
        };

        var getFieldChecked = function (row, key) {
            var el = findField(row, key);
            if (!el) {
                return false;
            }
            return el.checked === true;
        };

        var addPreviewRow = function (entry) {
            var $row = $('<tr/>');
            $('<td/>', { class: 'text-center' }).text(normalizePreviewText(entry.rowNo)).appendTo($row);
            $('<td/>').text(normalizePreviewText(entry.defineObject)).appendTo($row);
            $('<td/>').text(normalizePreviewText(entry.cyl)).appendTo($row);
            $('<td/>').text(normalizePreviewText(entry.sph)).appendTo($row);
            $('<td/>').text(normalizePreviewText(entry.quantity)).appendTo($row);
            $('<td/>').text(entry.needTools ? 'بله' : 'خیر').appendTo($row);
            $tbody.append($row);
        };

        var rows = $('#kt_invoice_form2 [data-kt-element="items"] tbody [data-kt-element="item"]');
        if (rows.length === 0) {
            var $emptyRow = $('<tr/>');
            $('<td/>', { class: 'text-muted text-center py-10', colspan: 6 })
                .text('آیتمی برای نمایش وجود ندارد')
                .appendTo($emptyRow);
            $tbody.append($emptyRow);
        } else {
            rows.each(function () {
                addPreviewRow({
                    rowNo: getFieldText(this, 'rowno'),
                    defineObject: getFieldText(this, 'defineobjecttxt'),
                    cyl: getFieldText(this, 'cyltxt'),
                    sph: getFieldText(this, 'sphtxt'),
                    quantity: getFieldText(this, 'quantityid'),
                    needTools: getFieldChecked(this, 'needtoolsid')
                });
            });
        }

        $modal.find('[data-preview="lens-total"]').text(getLensTotal());
        updateLensTotal();
        $modal.modal('show');
    }
     function Accept()
    {
        var quantity= $('#kt_invoice_form2 [data-kt-element="quantityid"]');
        testQuentity=0;
        quantity.each(function(index){
            if(parseInt($(this).val())<=0)
            {
            testQuentity=1
            return;
            }
        });

        if(testQuentity==1)
        {
        toastr.error('@ResourceAlert.ZeroQuantity', '');
         return;
        }
          var customer= $('#kt_invoice_form2 [data-kt-element="definecustomerid"]').val();
        if(customer==undefined || customer=='' ||customer==null )
        {
            toastr.error('@ResourceAlert.Customer', '');
            return;
        }

         $form = $("#kt_invoice_form2");
         var aa=$form.serialize();
          $.post('@Url.Action("OrderStock", "Orders")',
                     aa
                 )
                     .done(function (result) {

                         if (result.success) {
                             toastr.success("", '@ResourceAlert.AddSucces');
                             window.location.replace('@Url.Action("OrderStock", "Orders")?clearCustomer=1&_=' + Date.now());

                         } else {
                             toastr.error('@ResourceAlert.AddError', result.message);
                         }


                     }).fail(function () { toastr.error('@ResourceAlert.AddError', '') });


    }
    function AcceptSend()
    {
        var quantity= $('#kt_invoice_form2 [data-kt-element="quantityid"]');
        testQuentity=0;
        quantity.each(function(index){
            if(parseInt($(this).val())<=0)
            {
            testQuentity=1
            return;
            }
        });

        if(testQuentity==1)
        {
        toastr.error('@ResourceAlert.ZeroQuantity', '');
         return;
        }
          var customer= $('#kt_invoice_form2 [data-kt-element="definecustomerid"]').val();
        if(customer==undefined || customer=='' ||customer==null )
        {
            toastr.error('@ResourceAlert.Customer', '');
            return;
        }
         $form = $("#kt_invoice_form2");
         var aa=$form.serialize();
          $.post('@Url.Action("OrderStockSend", "Orders")',aa)
                     .done(function (result) {

                         if (result.success) {
                             toastr.success("", '@ResourceAlert.AddSucces');
                             window.location.replace('@Url.Action("OrderStock", "Orders")?clearCustomer=1&_=' + Date.now());
                         } else {
                             toastr.error('@ResourceAlert.AddError', result.message);
                         }


                     }).fail(function () { toastr.error('@ResourceAlert.AddError', '') });


    }

    var ListBrand = @Html.Raw(Json.Serialize(ViewBag.ListBrand));
     var ListLensType = @Html.Raw(Json.Serialize(ViewBag.ListLensType));
     var ListLensIndex = @Html.Raw(Json.Serialize(ViewBag.ListLensIndex));
     var ListSph = @Html.Raw(Json.Serialize(ViewBag.ListSph));
     var ListCyl = @Html.Raw(Json.Serialize(ViewBag.ListCyl));
     var ListCustomer = @Html.Raw(Json.Serialize(ViewBag.ListCustomer));


    sessionStorage.setItem('list_brand', JSON.stringify(ListBrand));
    sessionStorage.setItem('list_lenstype_r',JSON.stringify(ListLensType));
    sessionStorage.setItem('list_lensindex_r',JSON.stringify(ListLensIndex));
    sessionStorage.setItem('list_sph_r',JSON.stringify(ListSph));
    sessionStorage.setItem('list_cyl_r',JSON.stringify(ListCyl));
    $(function () {
        var lensTotalTarget = document.querySelector('#kt_invoice_form2 [data-kt-element="items"] tbody');
        if (lensTotalTarget) {
            var observer = new MutationObserver(function () {
                updateLensTotal();
            });
            observer.observe(lensTotalTarget, { childList: true, subtree: true });
        }
        $('#kt_invoice_form2').on('input change', '[data-kt-element="quantityid"]', function () {
            updateLensTotal();
        });
        updateLensTotal();

        var $defineCustomerId = $('#DefineCustomerId');
        var $defineCustomerSearch = $('#DefineCustomerSearch');
        var $defineCustomerSearchList = $('#DefineCustomerSearchList');
        var customerSearchTimer = null;
        var customerSearchRequest = null;
        var customerSearchToken = 0;

        function readCustomerItemId(item) {
            if (!item || typeof item !== 'object') {
                return '';
            }
            return String(item.defineCustomerId ?? item.DefineCustomerId ?? item.id ?? '').trim();
        }

        function readCustomerItemText(item) {
            if (!item || typeof item !== 'object') {
                return '';
            }
            return String(item.nameFormal ?? item.NameFormal ?? item.text ?? '').trim();
        }

        function clearCustomerSearchResults() {
            $defineCustomerSearchList.empty();
        }

        function renderCustomerSearchResults(items) {
            clearCustomerSearchResults();
            (items || []).forEach(function (item) {
                var id = readCustomerItemId(item);
                var text = readCustomerItemText(item);
                if (!id || !text) {
                    return;
                }
                var option = document.createElement('option');
                option.value = text;
                option.setAttribute('data-id', id);
                $defineCustomerSearchList.append(option);
            });
        }

        function applySelectedCustomerIdFromText() {
            var typedText = String($defineCustomerSearch.val() || '').trim();
            if (!typedText) {
                $defineCustomerId.val('');
                return;
            }

            var selectedId = '';
            $defineCustomerSearchList.find('option').each(function () {
                if (String($(this).val() || '').trim() === typedText) {
                    selectedId = String($(this).attr('data-id') || '').trim();
                    return false;
                }
            });

            if (!selectedId) {
                var match = (ListCustomer || []).find(function (item) {
                    var text = readCustomerItemText(item);
                    return text && text.toLowerCase() === typedText.toLowerCase();
                });
                if (match) {
                    selectedId = readCustomerItemId(match);
                }
            }

            $defineCustomerId.val(selectedId);
        }

        function syncCustomerSearchValueFromHidden() {
            var selectedId = String($defineCustomerId.val() || '').trim();
            if (!selectedId) {
                return;
            }
            var selectedText = '';
            $defineCustomerSearchList.find('option').each(function () {
                if (String($(this).attr('data-id') || '').trim() === selectedId) {
                    selectedText = String($(this).val() || '').trim();
                    return false;
                }
            });
            if (selectedText) {
                $defineCustomerSearch.val(selectedText);
            }
        }

        function filterLocalCustomers(term) {
            var text = String(term || '').trim().toLowerCase();
            if (!text) {
                return (ListCustomer || []);
            }
            return (ListCustomer || []).filter(function (item) {
                return readCustomerItemText(item).toLowerCase().indexOf(text) !== -1;
            });
        }

        function fetchCustomerSearchResults(term) {
            if (customerSearchRequest && customerSearchRequest.readyState !== 4) {
                customerSearchRequest.abort();
            }

            var token = ++customerSearchToken;
            customerSearchRequest = $.ajax({
                url: '@Url.Action("ListDefineCustomerSearch", "Orders")',
                type: 'POST',
                dataType: 'JSON',
                data: { search: term }
            }).done(function (data) {
                if (token !== customerSearchToken) {
                    return;
                }
                renderCustomerSearchResults(data && data.results ? data.results : []);
                applySelectedCustomerIdFromText();
            }).fail(function (_xhr, status) {
                if (status === 'abort') {
                    return;
                }
                renderCustomerSearchResults(filterLocalCustomers(term));
                applySelectedCustomerIdFromText();
            });
        }

        renderCustomerSearchResults(ListCustomer || []);
        syncCustomerSearchValueFromHidden();
        applySelectedCustomerIdFromText();

        var shouldClearCustomerAfterSave = '@(Context.Request.Query["clearCustomer"] == "1" ? "true" : "false")' === 'true';
        if (shouldClearCustomerAfterSave) {
            $defineCustomerId.val('');
            $defineCustomerSearch.val('');
            $('[data-kt-element="definecustomerid"]').val('');
            if (window.history && window.history.replaceState) {
                window.history.replaceState({}, document.title, '@Url.Action("OrderStock", "Orders")');
            }
        }

        $defineCustomerSearch
            .off('input.orderStockCustomerSearch')
            .on('input.orderStockCustomerSearch', function () {
                applySelectedCustomerIdFromText();
                var term = String($(this).val() || '').trim();
                if (customerSearchTimer) {
                    clearTimeout(customerSearchTimer);
                }
                if (term.length < 2) {
                    renderCustomerSearchResults(filterLocalCustomers(term));
                    return;
                }
                customerSearchTimer = setTimeout(function () {
                    fetchCustomerSearchResults(term);
                }, 250);
            })
            .off('change.orderStockCustomerSearch blur.orderStockCustomerSearch')
            .on('change.orderStockCustomerSearch blur.orderStockCustomerSearch', function () {
                applySelectedCustomerIdFromText();
            });

        function getPlaceholder($select) {
            return $select.attr('data-placeholder') || '';
        }

        function populateNativeSelect($select, items) {
            $select.empty();
            // Keep first option blank so cleared state shows no label text.
            $select.append($('<option/>', { value: '', text: '' }));
            (items || []).forEach(function (item) {
                $select.append($('<option/>', { value: item.id, text: item.text }));
            });
        }

        function clearNativeSelect($select) {
            populateNativeSelect($select, []);
            $select.val('');
        }

        function parseStoredList(key) {
            const raw = sessionStorage.getItem(key);
            if (!raw) {
                return [];
            }
            try {
                return JSON.parse(raw);
            } catch (_e) {
                return [];
            }
        }

        var $brand = $('[data-kt-element="brand"]');
        var $lensType = $('[data-kt-element="lenstype"]');
        var $lensIndex = $('[data-kt-element="lensindex"]');
        var $sph = $('[data-kt-element="sph"]');
        var $cyl = $('[data-kt-element="cyl"]');
        var $defineObject = $('[data-kt-element="defineobject"]');

        populateNativeSelect($brand, parseStoredList('list_brand'));
        clearNativeSelect($lensType);
        clearNativeSelect($lensIndex);
        clearNativeSelect($sph);
        clearNativeSelect($cyl);
        clearNativeSelect($defineObject);

        $brand.on('change', function () {
            if (window.__ktInvoiceEditRestore) {
                return;
            }
            var id = $(this).val();
            var data = parseStoredList('list_lenstype_r').filter(function (x) { return String(x.parentid) === String(id); });
            populateNativeSelect($lensType, data);
            clearNativeSelect($lensIndex);
            clearNativeSelect($sph);
            clearNativeSelect($cyl);
            clearNativeSelect($defineObject);
        });

        $lensType.on('change', function () {
            if (window.__ktInvoiceEditRestore) {
                return;
            }
            var id = $(this).val();
            var data = parseStoredList('list_lensindex_r').filter(function (x) { return String(x.parentid) === String(id); });
            populateNativeSelect($lensIndex, data);
            clearNativeSelect($sph);
            clearNativeSelect($cyl);
            clearNativeSelect($defineObject);
        });

        $lensIndex.on('change', function () {
            if (window.__ktInvoiceEditRestore) {
                return;
            }
            var id = $(this).val();
            var data = parseStoredList('list_sph_r').filter(function (x) { return String(x.parentid) === String(id); });
            populateNativeSelect($sph, data);
            clearNativeSelect($cyl);
            clearNativeSelect($defineObject);
        });

        $sph.on('change', function () {
            if (window.__ktInvoiceEditRestore) {
                return;
            }
            var id = $(this).val();
            var data = parseStoredList('list_cyl_r').filter(function (x) { return String(x.parentid) === String(id); });
            populateNativeSelect($cyl, data);
            clearNativeSelect($defineObject);
        });

        $cyl.on('change', function () {
            if (window.__ktInvoiceEditRestore) {
                return;
            }
            var id = $(this).val();
            var data = parseStoredList('list_cyl_r').filter(function (x) { return String(x.id) === String(id); });
            var defineObjectData = [];
            if (data.length > 0 && data[0].defineobjectid) {
                defineObjectData = [{ id: data[0].defineobjectid, text: data[0].nameobject }];
            }
            populateNativeSelect($defineObject, defineObjectData);
            if (defineObjectData.length > 0) {
                $defineObject.val(String(defineObjectData[0].id));
            } else {
                $defineObject.val('');
            }
            $defineObject.trigger('change');
        });

    });

</script>
