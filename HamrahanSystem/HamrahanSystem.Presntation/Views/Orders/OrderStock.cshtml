@model HamrahanSystem.Application.DTOs.TblLnsOrderDto
@{
    ViewBag.Title = "";
    string BasePage = "Orders";
}



<div class="card">
    <div class="card-header bg-primary"><h3 class="card-title align-items-start flex-column">@ResourcePages.OrderStock </h3> </div>
    <div class="card-body ltr">


        <!--begin::Form-->
        @* <form action="" id="kt_invoice_form"> *@
        <div id="kt_invoice_form">
            <!--begin::Wrapper-->
            <div class="mb-0">
                <!--begin::Row-->
                <div class="row gx-10 mb-5">
                    <div class="col-md-4 mb-2">
                        @Html.HiddenFor(model => model.DefineCustomerId, new { id = "DefineCustomerId", data_kt_element = "definecustomer", @Value = ViewBag.DefaultDefineCustomerId })
                        <input type="text" id="DefineCustomerSearch" class="form-control form-control-solid form-control-lg" placeholder="@ResourcePages.Base_DefineCustomer" autocomplete="off" list="DefineCustomerSearchList" value="@ViewBag.DefaultDefineCustomerName" />
                        <datalist id="DefineCustomerSearchList"></datalist>
                    </div>
                    <div class="col-md-4 mb-2">
                        @Html.TextBoxFor(model => model.StoreName, "", new { @class = "form-control form-control-solid ", placeholder = ResourcePages.Base_StoreName, data_kt_element = "storename" })
                    </div>

                </div>
                <!--begin::Separator-->
                <div class="separator separator-dashed my-10"></div>
                <!--end::Separator-->
                <div class="row gx-10 mb-5  " style="direction:ltr!important ">


                    <div class="col-md-4 mb-2">
                        <label class="form-label mb-1 text-center d-block orderstock-field-label">@ResourcePages.Base_Brand</label>
                        @Html.DropDownListFor(model => model.TblLnsOrderItems[0].BrandId, new List<SelectListItem>(), "", new { @class = "form-select form-select-solid form-select-lg ", data_placeholder = ResourcePages.Base_Brand, data_kt_element = "brand" })
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label mb-1 text-center d-block orderstock-field-label">@ResourcePages.Base_LensType</label>
                        @Html.DropDownListFor(model => model.TblLnsOrderItems[0].BrandLensTypeRId, new List<SelectListItem>(), "", new { @class = "form-select form-select-solid form-select-lg ", data_placeholder = ResourcePages.Base_LensType, data_kt_element = "lenstype" })
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label mb-1 text-center d-block orderstock-field-label">@ResourcePages.Base_LensIndex</label>
                        <div class="row">
                            <div class="col-md-10">
                                @Html.DropDownListFor(model => model.TblLnsOrderItems[0].LensTypeRLensIndexRId, new List<SelectListItem>(), "", new { @class = "form-select form-select-solid form-select-lg ", data_placeholder = ResourcePages.Base_LensIndex, data_kt_element = "lensindex" })
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="form-control text-center" data-kt-element="add-itemcyl"><i class="fa fa-table"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label mb-1 text-center d-block orderstock-field-label">@ResourcePages.Base_Sph</label>
                        @Html.DropDownListFor(model => model.TblLnsOrderItems[0].LensIndexRSphId, new List<SelectListItem>(), "", new { @class = "form-select form-select-solid form-select-lg ", data_placeholder = ResourcePages.Base_Sph, data_kt_element = "sph" })
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label mb-1 text-center d-block orderstock-field-label">@ResourcePages.Base_Cyl</label>
                        @Html.DropDownListFor(model => model.TblLnsOrderItems[0].SphCylId, new List<SelectListItem>(), "", new { @class = "form-select form-select-solid form-select-lg ", data_placeholder = ResourcePages.Base_Cyl, data_kt_element = "cyl" })
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label mb-1 text-center d-block orderstock-field-label">@ResourcePages.Base_DefineObject</label>
                        @Html.DropDownListFor(model => model.TblLnsOrderItems[0].DefineObjectId, new List<SelectListItem>(), "", new { @class = "form-select form-select-solid form-select-lg ", data_placeholder = ResourcePages.Base_DefineObject, data_kt_element = "defineobject", @disabled = "disabled" })
                    </div>
                    <div class="col-md-4 mb-2">
                        <div class="d-flex align-items-center gap-2 orderstock-qty-wrap">
                            <span class="orderstock-inline-label">@ResourcePages.Base_Quantity</span>
                            @Html.EditorFor(model => model.TblLnsOrderItems[0].Quantity, new { htmlAttributes = new { @Value = "1", @class = "form-control form-control-lg form-control-solid orderstock-quantity-input", @min = 1, data_kt_element = "quantity" } })
                        </div>
                    </div>
                    <div class="col-md-4 mb-2 d-flex align-items-end">
                        <div class="d-flex align-items-center gap-2 orderstock-tools-group">
                            <span class="orderstock-inline-label">@ResourcePages.Base_NeedTools</span>
                            @Html.CheckBoxFor(model => model.TblLnsOrderItems[0].NeedTools, new { @class = "form-check-input", data_kt_element = "needtools", @checked = true })
                        </div>
                    </div>





                </div>
                <div class="form-group text-center mb-4">
                    <button type="button" class="btn btn-success w-md-200px py-2 hover-scale" data-kt-element="add-item"><i class="fa fa-plus"></i> @ResourcePages.Add </button>
                </div>
                <form action="" id="kt_invoice_form2">
                    <!--begin::Table wrapper-->
                    <div class="table-responsive mb-10">

                        @Html.HiddenFor(model => model.DefineCustomerId, new { data_kt_element = "definecustomerid" })
                        @Html.HiddenFor(model => model.StoreName, new { data_kt_element = "storenametxt" })
                        @Html.HiddenFor(model => model.Consumer, new { data_kt_element = "consumertxt" })
                        <!--begin::Table-->
                        <table class="table g-5 gs-0 mb-0 fw-bold text-gray-700" data-kt-element="items">
                            <!--begin::Table head-->
                            <thead>
                                <tr class="border-bottom fs-7 fw-bold text-gray-700 text-uppercase">
                                    <th class="min-w-50px w-50px text-center">@ResourcePages.No</th>
                                    <th class="min-w-300px w-475px">@ResourcePages.Base_DefineObject</th>
                                    <th class="min-w-100px w-120px">@ResourcePages.Base_Cyl</th>
                                    <th class="min-w-100px w-120px">@ResourcePages.Base_Sph</th>

                                    <th class="min-w-80px w-150px ">@ResourcePages.Base_Quantity</th>
                                    <th class="min-w-80px w-150px ">@ResourcePages.Base_NeedTools</th>
                                    <th class="min-w-75px w-75px text-end">Action</th>
                                </tr>
                            </thead>
                            <!--end::Table head-->
                            <!--begin::Table body-->
                            <tbody>
                                <tr data-kt-element="empty">
                                    <th colspan="5" class="text-muted text-center py-10">گزینه ای در لیست وجود ندارد </th>
                                </tr>
                            </tbody>
                            <!--end::Table body-->
                            <!--begin::Table foot-->
                            <tfoot>
                            </tfoot>
                            <!--end::Table foot-->
                        </table>
                    </div>

                </form>
                <!--end::Table-->
                <!--begin::Item template-->
                <table class="table d-none" data-kt-element="item-template">
                    <tr class="border-bottom border-bottom-dashed border-gray-300" data-kt-element="item" data_kt_counter="0">
                        <td><Label data_kt_element="rowno"></Label></td>
                        <td class="pe-7" style="direction:ltr!important">
                            @Html.Label("DefineObject", "", new { @class = "form-control form-control-solid", data_kt_element = "defineobjecttxt" })
                            @Html.HiddenFor(model => model.TblLnsOrderItems[0].DefineObjectId, new { data_kt_element = "defineobjectid" })

                        </td>
                        <td>
                            @Html.Label("DefineObject", "", new { @class = "form-control form-control-solid", data_kt_element = "cyltxt" })
                            @Html.HiddenFor(model => model.TblLnsOrderItems[0].SphCylId, new { data_kt_element = "cylid" })
                            @Html.HiddenFor(model => model.TblLnsOrderItems[0].BrandLensTypeRId, new { data_kt_element = "lenstypeid" })
                            @Html.HiddenFor(model => model.TblLnsOrderItems[0].BrandId, new { data_kt_element = "brandid" })
                            @Html.HiddenFor(model => model.TblLnsOrderItems[0].LensTypeRLensIndexRId, new { data_kt_element = "lensindexid" })
                        </td>
                        <td class="ps-0">
                            @Html.Label("DefineObject", "", new { @class = "form-control form-control-solid", data_kt_element = "sphtxt" })
                            @Html.HiddenFor(model => model.TblLnsOrderItems[0].LensIndexRSphId, new { data_kt_element = "sphid" })
                        </td>

                        <td class="ps-0">
                            @Html.EditorFor(model => model.TblLnsOrderItems[0].Quantity, new { htmlAttributes = new { @class = "form-control form-control-lg form-control-solid", placeholder = ResourcePages.Base_Quantity, @min = 1, data_kt_element = "quantityid" } })

                        </td>
                        <td class="ps-0 ">

                            @Html.CheckBoxFor(model => model.TblLnsOrderItems[0].NeedTools, new { @class = "form-check-input", data_kt_element = "needtoolsid", @checked = true })


                        </td>
                        <td class="pt-5 text-end">
                            <button type="button" class="btn btn-sm btn-icon btn-active-color-primary me-1" data-kt-element="edit-item">
                                <i class="fa fa-edit fs-3"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-icon btn-active-color-primary" data-kt-element="remove-item">
                                <i class="ki-duotone ki-trash fs-3">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                    <span class="path3"></span>
                                    <span class="path4"></span>
                                    <span class="path5"></span>
                                </i>
                            </button>
                        </td>
                    </tr>
                </table>

                <table class="table d-none" data-kt-element="empty-template">
                    <tr data-kt-element="empty">
                        <th colspan="5" class="text-muted text-center py-10">No items</th>
                    </tr>
                </table>
                <!--end::Item template-->
                <!--begin::Notes-->
                <div class="mb-0">
                    <label class="form-label fs-6 fw-bold text-gray-700">@ResourcePages.Base_Description</label>

                    @Html.TextAreaFor(model => model.Description, 3, 0, new { @class = "form-control form-control-solid" })
                </div>
                <!--end::Notes-->
            </div>
            <!--end::Wrapper-->
            <div class="modal fade" role="dialog" id="modal-Order" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content rounded">
                        <div class="modal-header justify-content-end border-0 pb-0">
                            <!--begin::Close-->
                            <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                                <i class="ki-duotone ki-cross fs-1">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                </i>
                            </div>
                            <!--end::Close-->
                        </div>
                        <div class="modal-body pt-0 pb-15 px-5 px-xl-20 " id="modal-OrderCyl" data-kt-element="cylitems">
                            <div class="text-muted small mb-2" dir="rtl">سطرها: SPH ، ستون‌ها: CYL</div>
                            <div class="row mh-350px scroll-y cyl-grid-wrap" dir="ltr">
                            <table class="table g-5 gs-0 mb-0 fw-bold text-gray-700 cyl-grid-table">
                                <!--begin::Table head-->
                                <thead>
                                    <tr class="border-bottom fs-7 fw-bold text-gray-700 text-uppercase">
                                    </tr>
                                </thead>
                                <!--end::Table head-->
                                <!--begin::Table body-->
                                <tbody>
                                </tbody>
                            </table>
                            </div>
                            
                            <div class="row text-center mt-11">
                                <input type="button" data-kt-element="submit-itemcyl" class="btn btn-success" value="@ResourcePages.Add" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="table d-none" data-kt-element="item-templateCyl">
                <div data-kt-element="item-headercyl">
                    <table>
                        <thead>
                            <tr>
                                <th class="text-center cyl-grid-cell"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td data-kt-element="cylitem" class="text-center cyl-grid-cell">
                                    <div class="form-floating cyl-grid-input">
                                    <input type="text" data-kt-element="countlens" placeholder="" class="form-control" />
                                        <label data-kt-element="labelcountlens"></label>
                                  
                                    </div>
                                    <input type="hidden" data-kt-element="sphidgrid" />
                                    <input type="hidden" data-kt-element="sphtitlegrid" />
                                    <input type="hidden" data-kt-element="sphcylidgrid" />
                                    <input type="hidden" data-kt-element="sphcyltitlegrid" />
                                    <input type="hidden" data-kt-element="defineobjectidgrid" />
                                    <input type="hidden" data-kt-element="defineobjecttitlegrid" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
               
            </div>
        </div>
        <!--end::Form-->
        <div class="modal fade" role="dialog" id="modal-OrderPreview" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content rounded">
                    <div class="modal-header justify-content-between border-0 pb-0">
                        <h3 class="modal-title">پیش نمایش سفارش</h3>
                        <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                            <i class="ki-duotone ki-cross fs-1">
                                <span class="path1"></span>
                                <span class="path2"></span>
                            </i>
                        </div>
                    </div>
                    <div class="modal-body pt-0 pb-15 px-5 px-xl-20">
                        <div class="row g-5 mb-6" id="orderPreviewHeader">
                            <div class="col-12">
                                <div class="d-flex flex-column">
                                    <span class="text-muted fs-7">@ResourcePages.Base_DefineCustomer</span>
                                    <span class="fw-semibold text-gray-800" data-preview="customer">--</span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="d-flex flex-column">
                                    <span class="text-muted fs-7">@ResourcePages.Base_Description</span>
                                    <span class="fw-semibold text-gray-800" data-preview="description" style="white-space: pre-wrap;">--</span>
                                </div>
                            </div>
                        </div>
                        <div class="separator separator-dashed my-6"></div>
                        <div class="table-responsive">
                            <table class="table g-5 gs-0 mb-0 fw-bold text-gray-700">
                                <thead>
                                    <tr class="border-bottom fs-7 fw-bold text-gray-700 text-uppercase">
                                        <th class="min-w-50px w-50px text-center">@ResourcePages.No</th>
                                        <th class="min-w-300px w-475px">@ResourcePages.Base_DefineObject</th>
                                        <th class="min-w-100px w-120px">@ResourcePages.Base_Cyl</th>
                                        <th class="min-w-100px w-120px">@ResourcePages.Base_Sph</th>
                                        <th class="min-w-80px w-150px">@ResourcePages.Base_Quantity</th>
                                        <th class="min-w-80px w-150px">@ResourcePages.Base_NeedTools</th>
                                    </tr>
                                </thead>
                                <tbody data-preview="items-body"></tbody>
                            </table>
                        </div>
                        <div class="text-end fw-bold mt-4 mb-4">
                            <span class="me-2">جمع تعداد عدسی:</span>
                            <span data-preview="lens-total">0</span>
                        </div>
                        <div class="text-center mt-8">
                            <input type="button" onclick="Accept()" class="btn btn-primary" value="@ResourcePages.Add" />
                            <input type="button" onclick="AcceptSend()" class="btn btn-primary" value="@ResourcePages.AddSend" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-end fw-bold mb-4">
            <span class="me-2">جمع تعداد عدسی:</span>
            <span data-kt-element="lens-total">0</span>
        </div>
        <div class="form-group text-center mb-4">
            <input type="button" onclick="Accept()" class="btn btn-primary" value="@ResourcePages.Add" />
            <input type="button" onclick="PreviewOrder()" class="btn btn-light-primary" value="پیش نمایش" />
            <input type="button" onclick="AcceptSend()" class="btn btn-primary" value="@ResourcePages.AddSend" />
        </div>
    </div>
</div>

<style>
