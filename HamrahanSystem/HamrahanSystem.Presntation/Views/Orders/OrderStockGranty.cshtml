        function focusAddItemButton() {
            var $button = $('[data-kt-element="add-item"]:enabled').first();
            if ($button.length) {
                $button.focus();
            }
        }

        $(document).on('keydown', function (e) {
            if (e.key !== 'Tab' || e.shiftKey) {
                return;
            }
            if (!isOuSelected()) {
                return;
            }
            if (!isRightEyeLastFieldFocused()) {
                if (isLeftEyeLastFieldFocused()) {
                    e.preventDefault();
                    focusAddItemButton();
                }
                return;
            }
            e.preventDefault();
            focusLeftEyeStart();
        });

