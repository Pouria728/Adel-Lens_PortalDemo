@{
    ViewBag.Title = "";
    string BasePage = "Orders";
}

<div class="card">
    <div class="card-header bg-primary"><h3 class="card-title align-items-start flex-column">@ResourcePages.ListOrder </h3> </div>
    <div class="card-body">
        @*   <div class="col-md-8">
            <select id="ProductId" class="form-select form-select-solid" data-control="select2" data-placeholder="Select an option" data-hide-search="true">
            </select>
        </div> *@

        <div class="form-group row mb-6">
            @Html.Label(ResourcePages.OrderType, ResourcePages.OrderType, htmlAttributes: new { @class = "col-lg-2 col-form-label  fw-semibold fs-6" })
            <div class="col-md-4">
                @Html.DropDownList("listDocument", (List<SelectListItem>)ViewBag.ListDocument,"", new { @class = "form-select form-select-solid form-select-lg ", aria_label = "", data_control = "select2", data_placeholder = "", data_allow_clear = "true" })
                @* @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" }) *@
            </div>
            @Html.Label(ResourcePages.OrderStatus, ResourcePages.OrderStatus, htmlAttributes: new { @class = "col-lg-2 col-form-label fw-semibold fs-6" })
            <div class="col-md-4">
                @Html.DropDownList("OrderStatus", (List<SelectListItem>)ViewBag.ListStatusOrder,"", new { @class = "form-select form-select-solid form-select-lg ", aria_label = "", data_control = "select2", data_placeholder = "", data_allow_clear = "true" })
                @* @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" }) *@
            </div>

        </div>
        <div class="form-group row mb-6">

            @Html.Label(ResourcePages.CustomerId, ResourcePages.CustomerId, htmlAttributes: new { @class = "col-lg-2 col-form-label fw-semibold fs-6" })
            <div class="col-md-4">
                @Html.DropDownList("customer", new List<SelectListItem>(), new { @class = "form-select form-select-solid form-select-lg ", aria_label = "", data_control = "select2", data_placeholder = "", data_allow_clear = "true" } )
                @* @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" }) *@
            </div>
            @Html.Label(ResourcePages.FactorNo, ResourcePages.FactorNo, htmlAttributes: new { @class = "col-lg-2 col-form-label fw-semibold fs-6" })
            <div class="col-md-4">
                @Html.TextBox("factorNo", "", new { @class = "form-control form-control-solid ", aria_label = "",  data_placeholder = ResourcePages.FactorNo, data_allow_clear = "true" })
                @* @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" }) *@
            </div>
        </div>
        <div class="form-group row mb-6">
            <label class="col-lg-2 col-form-label fw-semibold fs-6" for="createdBy">&#1705;&#1575;&#1585;&#1576;&#1585; &#1579;&#1576;&#1578; &#1705;&#1606;&#1606;&#1583;&#1607;</label>
            <div class="col-md-4">
                @Html.DropDownList("createdBy", new List<SelectListItem>(), new { @class = "form-select form-select-solid form-select-lg ", aria_label = "", data_control = "select2", data_placeholder = "", data_allow_clear = "true" })
            </div>
            <div class="col-lg-2"></div>
            <div class="col-md-4"></div>
        </div>
        <div class="form-group row mb-6">
            <label class="col-lg-2 col-form-label fw-semibold fs-6">از تاریخ</label>
            <div class="col-md-4">
                @Html.TextBox("fromDate", "", new { @class = "form-control form-control-solid DatePicker", autocomplete = "off" })
            </div>
            <label class="col-lg-2 col-form-label fw-semibold fs-6">تا تاریخ</label>
            <div class="col-md-4">
                @Html.TextBox("toDate", "", new { @class = "form-control form-control-solid DatePicker", autocomplete = "off" })
            </div>
        </div>
        <div class="form-group row mb-6">


            <div class="col-md-6 text-center ">
                <input type="button" onclick="LoadItems()" class="btn btn-primary" value="@ResourcePages.Search" />
            </div>
        </div>

        <div class="form-group" id="divjqGrid">
            <table id="jqGrid" class="table table-striped"></table>
            <div id="jqGridPager"></div>
        </div>

    </div>
</div>


<script type="text/javascript">
     var ListBrand = @Html.Raw(Json.Serialize(ViewBag.ListBrand));
     var ListLensType = @Html.Raw(Json.Serialize(ViewBag.ListLensType));
     var ListLensIndex = @Html.Raw(Json.Serialize(ViewBag.ListLensIndex));
     
     var ListCyl = @Html.Raw(Json.Serialize(ViewBag.ListCyl));
    var ListSph = @Html.Raw(Json.Serialize(ViewBag.ListSph));

    sessionStorage.setItem('list_brand', JSON.stringify(ListBrand));
    sessionStorage.setItem('list_lenstype_r',JSON.stringify(ListLensType));
    sessionStorage.setItem('list_lensindex_r',JSON.stringify(ListLensIndex));
    
    sessionStorage.setItem('list_cyl_r',JSON.stringify(ListCyl));
    sessionStorage.setItem('list_sph_r',JSON.stringify(ListSph));

    function LoadDialog(nodeId, typeId) {
        //$("#modal-loader").html("");
            url = ''
            switch (typeId) {
               
                case 2: url = '@Url.Action("ShowOrder", BasePage)';
                    break;
            }

            if (typeId != 3) {
                $.get(url, typeId >= 1 ? { id: nodeId } : {})
                    .done(function (result) {

                        $("#modal-loader").html(result);
                        $("#modal-Tree").modal('show');
                    }).fail(function () { toastr.error('@ResourceAlert.AddError', '') });
            }
           
        $(document).resize();

    }
    function HighlightSortedColumn(sortName) {
        var grid = $('#jqGrid');
        var colModel = grid.jqGrid('getGridParam', 'colModel');
        var colName = sortName;
        for (var i = 0; i < colModel.length; i++) {
            if (colModel[i].index === sortName || colModel[i].name === sortName) {
                colName = colModel[i].name;
                break;
            }
        }
        var header = grid.closest('.ui-jqgrid');
        header.find('tr.ui-jqgrid-labels th').removeClass('sorted-column');
        header.find('#jqGrid_' + colName).addClass('sorted-column');
    }

    function LoadItems() {
         $('#modal-Tree').modal('hide');
        $.jgrid.defaults.responsive = true;
        $.jgrid.defaults.styleUI = 'Bootstrap';

        $('#jqGrid').jqGrid({
            url:'@Url.Action("Detail", BasePage)',
            datatype: 'json',
            mtype: 'POST',
            serializeGridData: function (postData) {
                var data = {
                    orderstatusid:$('#OrderStatus').val(),
                    indexdocumetid:$('#listDocument').val(),
                    customerId:$('#customer').val(),
                    createdById:$('#createdBy').val(),
                    factorNo:$('#factorNo').val(),
                    fromDate:$('#fromDate').val(),
                    toDate:$('#toDate').val()
                };
                postData._search = true;
                // if (postData.searchField == undefined) {
                //     postData.searchField = "";
                //     postData.searchOper = "";
                //     postData.searchString = "";
                // }
                data = $.extend(data, postData);
                return JSON.stringify(data);
            },
          // ajaxGridOptions: { contentType: "application/json" },
       colNames: ['@ResourcePages.Base_Id','@ResourcePages.Base_DefineCustomer','&#1705;&#1575;&#1585;&#1576;&#1585; &#1579;&#1576;&#1578; &#1705;&#1606;&#1606;&#1583;&#1607;','@ResourcePages.Base_Factore','@ResourcePages.OrderStatus','@ResourcePages.IndexDocument','@ResourcePages.CreateDate', ''],
            colModel: [
                { name: 'id', index: 'id', align: "Center", hidden: true, key: true, search: false },
                { name: 'customer', index: 'customer', align: "Center", sortable: true, search: true },
                { name: 'createdByUser', index: 'createdByUser', align: "Center", sortable: true, search: false },
                { name: 'factorNo', index: 'factorNo', align: "Center", sortable: true, search: true },
                { name: 'statusOrder', index: 'statusOrder', align: "Center", sortable: true, search: true },
                { name: 'indexDocuments', index: 'indexDocuments', align: "Center", sortable: true, search: false },
                { name: 'createDate', index: 'createDate', align: "Center", sortable: true, search: false },
                

                {
                    name: 'id', index: 'Action', align: "Center", sortable: false, search: false,
                    formatter: function (value, rowData, index) {

                        var a = '<button type="button"   title="@ResourcePages.Edit" onclick="LoadDialog(\'' + value + '\',2);"><i class="fa fa-2x fa-pen"></i> </button> ';
                        return a;

                    }
                }
            ],
            subGridRowExpanded:function(subgrid_id, row_id) {},
            subGridRowColapsed: function(subgrid_id, row_id) {},
            subgroup:true,
            //pager: '#pager',
            rowNum: 20,
            sortname: 'factorNo',
            sortorder: 'desc',
            //width: newWidth,
            toppager: true,
            height: 500,
            direction: 'rtl',
            rowList: [10, 20, 30, 40],
            viewrecords: true,
            gridview: true,
            altRows: true,
            hidegrid: false,
            rownumbers: true,
            recordpos: 'left',
            multiselect: false,
            scroll: true,
            scrollrows: false,
            jsonReader: {
                page: function (obj) { return obj.page; },
                total: function (obj) { return obj.total; },
                records: function (obj) { return obj.records; },
                root: function (obj) { return obj.rows; },
                repeatitems: false,
                id: "0"
            },
            onSortCol: function (index, iCol, sortorder) {
                HighlightSortedColumn(index);
            },
            loadComplete: function () {
                var grid = $('#jqGrid');
                HighlightSortedColumn(grid.jqGrid('getGridParam', 'sortname'));
            },
            pager: "#jqGridPager",
            caption: '@ResourcePages.ListOrder'
        });
        $('#jqGrid').trigger('reloadGrid');
        // $('#jqGrid').navGrid('#jqGridPager',
        //     {
        //         edit: false, add: false, del: false, search: true, refresh: true, view: false, position:"right", cloneToTop: true
        //     }, {}, {}, {}, { sopt: ['cn'] });
        $(document).resize();

    }
    $(function () {
        LoadItems();
        if (typeof datepicker === 'function') {
            datepicker();
        }


        $("#customer").select2({
            //theme: "bootstrap4",
             //dropdownParent: $("#modal-Tree"),
            language: 'fa',
            minimumInputLength: 2,
            dir:"rtl",
            ajax: {
                url:  '@Url.Action("ListDefineCustomerSearch", "Orders")',
                type: 'POST',
                dataType: 'JSON',
                // contentType: "application/json; charset=utf-8",
                delay: 250,
                data:
                    function (params) {
                        var test={search:params.term}
                        return test // search term

                    }
                    ,
                processResults: function (data) {

                    return {
                        results: data.results
                    };
                },
                cache: true
            }
        });

        $("#createdBy").select2({
            language: 'fa',
            minimumInputLength: 1,
            dir: "rtl",
            ajax: {
                url:  '@Url.Action("ListUserSearch", "Orders")',
                type: 'POST',
                dataType: 'JSON',
                delay: 250,
                data:
                    function (params) {
                        var request = { search: params.term }
                        return request
                    },
                processResults: function (data) {

                    return {
                        results: data.results
                    };
                },
                cache: true
            }
        });

    });

</script>

<style>
    .sorted-column,
    .sorted-column .ui-jqgrid-sortable {
        color: #0d6efd;
        font-weight: 700;
    }
</style>
