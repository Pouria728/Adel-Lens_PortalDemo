<div class="card custom-lens-order">
    <div class="card-header bg-primary"><h3 class="card-title align-items-start flex-column">عدسی سفارشی</h3></div>
    <div class="card-body">
        <form id="customLensOrderForm" autocomplete="off">
        <div class="card mb-6 custom-lens-customer">
            <div class="card-header bg-info"><h3 class="card-title align-items-start flex-column">اطلاعات مشتری</h3></div>
            <div class="card-body">
                <div class="customer-grid">
                    <div class="customer-cell">
                        <div class="customer-code">CUSTOMER</div>
                        @Html.HiddenFor(model => model.DefineCustomerId, new { id = "DefineCustomerId", data_kt_element = "definecustomer" })
                        <input type="text" id="DefineCustomerSearch" class="form-control form-control-solid form-control-sm" placeholder="مشتری" autocomplete="off" list="DefineCustomerSearchList" />
                        <datalist id="DefineCustomerSearchList"></datalist>
                        <div class="customer-caption">انتخاب مشتری</div>
                    </div>
                    <div class="customer-cell">
                        <div class="customer-code">STORE NAME</div>
                        @Html.TextBoxFor(model => model.StoreName, "", new { @class = "form-control form-control-solid form-control-sm", placeholder = "نام فروشگاه", data_kt_element = "store" })
                        <div class="customer-caption">بصورت انگلیسی وارد شود</div>
                    </div>
