            function validateColoringTypeRules() {
                var selectedType = String($coloringType.val() || "").toUpperCase();
                var isFull = selectedType === "FULL";
                var isGradual = selectedType === "GRADUAL";
                var isSameAsSample = selectedType === "SAME AS SAMPLE";
                function isValidPercent($input) {
                    var raw = String($input.val() || "").trim().replace(",", ".");
                    var num = Number(raw);
                    return raw !== "" && Number.isFinite(num) && num >= 0 && num <= 100;
                }

                if (isSameAsSample || (!isFull && !isGradual)) {
                    setColorSelectValidationState($color, true);
                    setColorInputValidationState($colorRatio, true);
                    setColorInputValidationState($topRatio, true);
                    setColorInputValidationState($bottomRatio, true);
                    setColorSelectValidationState($extraService, true);
                    return true;
                }

                var hasColor = hasSelectedValue($color);

                setColorSelectValidationState($color, hasColor);

                if (isFull) {
                    var hasValidRatio = isValidPercent($colorRatio);
                    setColorInputValidationState($colorRatio, hasValidRatio);
                    setColorInputValidationState($topRatio, true);
                    setColorInputValidationState($bottomRatio, true);
                    setColorSelectValidationState($extraService, true);
                    return hasColor && hasValidRatio;
                }

                var hasValidTopRatio = isValidPercent($topRatio);
                var hasValidBottomRatio = isValidPercent($bottomRatio);
                setColorInputValidationState($colorRatio, true);
                setColorInputValidationState($topRatio, hasValidTopRatio);
                setColorInputValidationState($bottomRatio, hasValidBottomRatio);
                setColorSelectValidationState($extraService, true);
                return hasColor && hasValidTopRatio && hasValidBottomRatio;
            }

            function syncColoringTypeRules() {
                var selectedType = String($coloringType.val() || "").toUpperCase();
                var isFull = selectedType === "FULL";
                var isGradual = selectedType === "GRADUAL";
                var isSameAsSample = selectedType === "SAME AS SAMPLE";

                if (isFull) {
                    $color.prop("disabled", false).trigger("change");
                    $colorRatio.prop("disabled", false);
                    $color.attr("required", "required");
                    $colorRatio.attr("required", "required");

                    $topRatio.val("");
                    $bottomRatio.val("");
                    $extraService.val(null).trigger("change");

                    $topRatio.prop("disabled", true).removeAttr("required");
                    $bottomRatio.prop("disabled", true).removeAttr("required");
                    $extraService.prop("disabled", false).trigger("change");

                    setColorInputValidationState($topRatio, true);
                    setColorInputValidationState($bottomRatio, true);
                    setColorSelectValidationState($extraService, true);
                } else if (isGradual) {
                    $color.prop("disabled", false).trigger("change");
                    $topRatio.prop("disabled", false);
                    $bottomRatio.prop("disabled", false);
                    $color.attr("required", "required");
                    $topRatio.attr("required", "required");
                    $bottomRatio.attr("required", "required");

                    $colorRatio.val("");
                    $extraService.val(null).trigger("change");
                    $colorRatio.prop("disabled", true).removeAttr("required");
                    $extraService.prop("disabled", false).trigger("change");

                    setColorInputValidationState($colorRatio, true);
                    setColorSelectValidationState($extraService, true);
                } else if (isSameAsSample) {
                    $color.val(null).trigger("change");
                    $extraService.val(null).trigger("change");
                    $colorRatio.val("");
                    $topRatio.val("");
                    $bottomRatio.val("");

                    $color.prop("disabled", true).trigger("change");
                    $colorRatio.prop("disabled", true);
                    $topRatio.prop("disabled", true);
                    $bottomRatio.prop("disabled", true);
                    $extraService.prop("disabled", false).trigger("change");

                    $color.removeAttr("required");
                    $colorRatio.removeAttr("required");
                    $topRatio.removeAttr("required");
                    $bottomRatio.removeAttr("required");
                    $extraService.removeAttr("required");
                } else {
                    $color.prop("disabled", false).trigger("change");
                    $colorRatio.prop("disabled", false);
                    $topRatio.prop("disabled", false);
                    $bottomRatio.prop("disabled", false);
                    $extraService.prop("disabled", false).trigger("change");

                    $color.removeAttr("required");
                    $colorRatio.removeAttr("required");
                    $topRatio.removeAttr("required");
                    $bottomRatio.removeAttr("required");
                    $extraService.removeAttr("required");
                }

                syncExtraServiceByDia();
                validateColoringTypeRules();
            }

            function parseDiaNumber($field) {
                var raw = String($field.val() || "").trim().replace(",", ".");
                if (!raw) {
                    return null;
                }
                var parsed = Number(raw);
                return Number.isFinite(parsed) ? parsed : null;
            }

            function syncExtraServiceByDia() {
                var rightDia = parseDiaNumber($rDia);
                var leftDia = parseDiaNumber($lDia);
                var hasDiaBelow50 = (rightDia !== null && rightDia < 50) || (leftDia !== null && leftDia < 50);

                if (hasDiaBelow50) {
                    $extraService.val("TOOLS").trigger("change");
                }

                $extraService.prop("disabled", false).trigger("change");
                setColorSelectValidationState($extraService, true);
            }

            function syncFrameByDiaAvailability() {
                var hasRightDia = hasSelectedValue($rDia);
                var hasLeftDia = hasSelectedValue($lDia);
                var disableCommon = hasRightDia && hasLeftDia;

                [$hBox, $vBox, $dbl, $ed].forEach(function ($field) {
                    $field.prop("disabled", disableCommon);
                    if (disableCommon) {
                        setFrameValidationState($field, true);
                    }
                });

                $ipdr.prop("disabled", hasRightDia);
                if (hasRightDia) {
                    setFrameValidationState($ipdr, true);
                }

                $ipdl.prop("disabled", hasLeftDia);
                if (hasLeftDia) {
                    setFrameValidationState($ipdl, true);
                }
            }

            function validateFrameByDiaRules() {
                syncFrameByDiaAvailability();
                var hasRightDia = hasSelectedValue($rDia);
                var hasLeftDia = hasSelectedValue($lDia);

                var requireCommon = !hasRightDia || !hasLeftDia;
                var requireIpdr = !hasRightDia;
                var requireIpdl = !hasLeftDia;

                var commonFields = [$hBox, $vBox, $dbl, $ed];
                var commonValid = true;
                commonFields.forEach(function ($field) {
                    var valid = $field.prop("disabled") || !requireCommon || hasInputValue($field);
                    setFrameValidationState($field, valid);
                    if (!valid) {
                        commonValid = false;
                    }
                });

                var ipdrValid = $ipdr.prop("disabled") || !requireIpdr || hasInputValue($ipdr);
                var ipdlValid = $ipdl.prop("disabled") || !requireIpdl || hasInputValue($ipdl);
                setFrameValidationState($ipdr, ipdrValid);
                setFrameValidationState($ipdl, ipdlValid);

                return commonValid && ipdrValid && ipdlValid;
            }

            function enforceAxisDigits($axis) {
                var raw = String($axis.val() || "");
                var normalized = raw.replace(/[^\d]/g, "");
                if (normalized.length > 3) {
                    normalized = normalized.substring(0, 3);
                }
                if (normalized) {
                    var numeric = parseInt(normalized, 10);
                    if (Number.isFinite(numeric) && numeric > 180) {
                        normalized = "180";
                    }
                }
                if (raw !== normalized) {
                    $axis.val(normalized);
                }
            }

