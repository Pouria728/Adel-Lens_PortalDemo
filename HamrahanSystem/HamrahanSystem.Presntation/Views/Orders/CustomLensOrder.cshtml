            function validateAxisForEye(eye) {
                var isRight = eye === "r";
                var $axis = isRight ? $rAxis : $lAxis;
                var $cyl = isRight ? $rCyl : $lCyl;
                var axisValue = parseAxisValue($axis.val());
                var hasCyl = hasSelectedValue($cyl);

                if (!hasCyl) {
                    if (axisValue === null) {
                        setAxisValidationState($axis, true);
                        return true;
                    }
                    if (Number.isNaN(axisValue)) {
                        setAxisValidationState($axis, false);
                        return false;
                    }
                    setAxisValidationState($axis, true);
                    return true;
                }

                if (axisValue === null) {
                    setAxisValidationState($axis, false);
                    return false;
                }
                if (Number.isNaN(axisValue)) {
                    setAxisValidationState($axis, false);
                    return false;
                }

                setAxisValidationState($axis, true);
                return true;
            }

