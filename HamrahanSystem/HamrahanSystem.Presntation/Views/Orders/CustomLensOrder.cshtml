            function bindFrameNumericInputs() {
                var $inputs = $(".custom-lens-frame input.frame-numeric");
                $inputs.each(function () {
                    var $input = $(this);
                    $input.attr("step", "0.1");
                    if ($input.hasClass("frame-min-one")) {
                        $input.attr("min", "1");
                    } else {
                        $input.removeAttr("min");
                    }
                    $input.attr("inputmode", "decimal");
                });

                $inputs.off("keydown.frameNumeric").on("keydown.frameNumeric", function (e) {
                    var forceMinOne = $(this).hasClass("frame-min-one");
                    if (e.key === "e" || e.key === "E" || e.key === "+" || (forceMinOne && e.key === "-")) {
                        e.preventDefault();
                    }
                });

                $inputs.off("input.frameNumeric").on("input.frameNumeric", function () {
                    var raw = String(this.value || "");
                    var normalized = raw.replace(",", ".");
                    normalized = normalized.replace(/[^0-9.\-]/g, "");

                    if ($(this).hasClass("frame-min-one")) {
                        normalized = normalized.replace(/\-/g, "");
                    } else {
                        var isNegative = normalized.indexOf("-") === 0;
                        normalized = (isNegative ? "-" : "") + normalized.replace(/\-/g, "");
                    }

                    var firstDot = normalized.indexOf(".");
                    if (firstDot !== -1) {
                        normalized = normalized.substring(0, firstDot + 1) + normalized.substring(firstDot + 1).replace(/\./g, "");
                    }

                    if (normalized !== raw) {
                        this.value = normalized;
                    }
                });

                $inputs.off("blur.frameNumeric").on("blur.frameNumeric", function () {
                    if (!$(this).hasClass("frame-min-one")) {
                        return;
