                var coatings = canEnable ? getCoatingsByDesignType(designTypeId) : [];
                var currentValue = $coating.val();
                initSelect($coating, coatings, "COATING");

                var hasCurrent = coatings.some(function (x) { return sameId(readItemId(x), currentValue); });
                if (hasCurrent) {
                    $coating.val(normalizeComparable(currentValue));
                } else {
                    $coating.val(null);
                }

                $coating.prop('disabled', !canEnable || coatings.length === 0).trigger('change');
            }

