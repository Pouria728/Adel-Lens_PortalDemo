            function copyEye(fromPrefix, toPrefix) {
                var fields = ["Sph", "Cyl", "Axis", "Add", "Dia", "DC", "Position", "Prism", "BasePrism", "StockItem"];
                fields.forEach(function (field) {
                    var $from = $("#" + fromPrefix + field);
                    var $to = $("#" + toPrefix + field);
                    if (!$from.length || !$to.length) {
                        return;
                    }
                    var val = $from.val();
                    $to.val(val);
                    if ($to.hasClass("select2-hidden-accessible")) {
                        $to.trigger("change");
                    } else {
                        $to.trigger("change");
                    }
                });
            }

