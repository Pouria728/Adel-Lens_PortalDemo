                var raw = String(value || "").trim();
                if (!raw) {
                    return null;
                }
                if (!/^\d+$/.test(raw)) {
                    return NaN;
                }
                var num = parseInt(raw, 10);
                if (!Number.isInteger(num) || num < 1 || num > 180) {
                    return NaN;
                }
                return num;
            }

