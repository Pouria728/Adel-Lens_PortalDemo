        --cl-border: #dbe3f1;
        --cl-border-strong: #3b82f6;
        --cl-bg-field: #f7f9fc;
        --cl-text: #2b2b2b;
        --cl-muted: #8b8b8b;
        --cl-shadow: 0 6px 18px rgba(28, 54, 102, 0.06);
        position: relative;
    }
    .custom-lens-order > .card-body > .card {
        border: 1px solid var(--cl-border);
        border-radius: var(--cl-radius-card);
        box-shadow: var(--cl-shadow);
        overflow: hidden;
    }
    .custom-lens-order .card-header {
        border-top-left-radius: var(--cl-radius-card);
        border-top-right-radius: var(--cl-radius-card);
    }
    .custom-lens-order .form-control.form-control-solid,
    .custom-lens-order .form-select.form-select-solid {
        border-radius: var(--cl-radius-field);
    }
    .custom-lens-order .select2-container--default .select2-selection--single {
        height: 42px;
        border-radius: var(--cl-radius-field);
        border: 1px solid transparent;
        background: var(--cl-bg-field);
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .custom-lens-order .select2-container--default.select2-container--open .select2-selection--single {
