            $vBox.on("input change", function () { validateFrameByDiaRules(); });
            $dbl.on("input change", function () { validateFrameByDiaRules(); });
            $ed.on("input change", function () { validateFrameByDiaRules(); });
            $ipdr.on("input change", function () { validateFrameByDiaRules(); });
            $ipdl.on("input change", function () { validateFrameByDiaRules(); });
            $coloringType.on("change", function () { syncColoringTypeRules(); });
            $color.on("change", function () { validateColoringTypeRules(); });
            $colorRatio.on("input change", function () { validateColoringTypeRules(); });
            $topRatio.on("input change", function () { validateColoringTypeRules(); });
            $bottomRatio.on("input change", function () { validateColoringTypeRules(); });

            function getSelectedText($select) {
                return String($select.find("option:selected").text() || "").trim();
            }

            function parseNullableScaledShort(value) {
                var parsed = parseNullableNumber(value);
                if (parsed == null) {
                    return null;
                }
                return Math.round(parsed * 100);
            }

            function mapPositionCode(value) {
                var normalized = String(value || "").trim().toUpperCase();
                if (normalized === "TO NASAL") {
                    return 1;
                }
                if (normalized === "TO TEMPLE") {
                    return 2;
                }
                return null;
            }

            function mapBasePrismCode(value) {
                var normalized = String(value || "").trim().toUpperCase();
                var map = {
                    "UP": 1,
                    "DOWN": 2,
                    "IN": 3,
                    "OUT": 4,
                    "IN/UP": 5,
                    "IN/DOWN": 6,
                    "OUT/UP": 7,
                    "OUT/DOWN": 8
                };
                return Object.prototype.hasOwnProperty.call(map, normalized) ? map[normalized] : null;
            }

            function buildEyeMeta(meta) {
                var parts = [];
                Object.keys(meta || {}).forEach(function (key) {
                    var value = String(meta[key] == null ? "" : meta[key]).trim();
                    if (value) {
                        parts.push(key + "=" + value);
                    }
                });
                return parts.join(";");
            }

            function trimToMaxLength(value, maxLength) {
                var text = String(value == null ? "" : value).trim();
                if (!text) {
                    return "";
                }
                if (!maxLength || maxLength <= 0 || text.length <= maxLength) {
                    return text;
                }
                return text.substring(0, maxLength);
            }

            function buildOrderMeta() {
                var maxLength = 254;
                var currentLength = 0;
                var parts = [];
                var fittingRText = String($("#FITTINGR").val() || "").trim().replace(",", ".");
                var fittingLText = String($("#FITTINGL").val() || "").trim().replace(",", ".");
                var candidates = [
                    { key: "FITTING-R", value: fittingRText },
                    { key: "FITTING-L", value: fittingLText },
                    { key: "DELIVERYTYPE", value: hasValue($("#DeliveryType").val()) ? getSelectedText($("#DeliveryType")) : "" },
                    { key: "BASECURVE", value: getSelectedText($baseCurve) },
                    { key: "LENSINDEX", value: getSelectedText($lensIndex) },
                    { key: "MATERIAL", value: getSelectedText($materialType) },
                    { key: "COATING", value: getSelectedText($coating) },
                    { key: "COLORINGTYPE", value: getSelectedText($coloringType) },
                    { key: "SERVICE", value: getSelectedText($extraService) }
                ];

                candidates.forEach(function (item) {
                    var value = trimToMaxLength(item.value, 80);
                    if (!value) {
                        return;
                    }

                    var pair = item.key + "=" + value;
                    var pairLength = pair.length + (parts.length > 0 ? 1 : 0);
                    if (currentLength + pairLength > maxLength) {
                        return;
                    }

                    parts.push(pair);
                    currentLength += pairLength;
                });

                return parts.join(";");
            }

            function buildEyeItem(isRight, defineObjectId, consumer, storeName, needTools) {
                var $sph = isRight ? $rSph : $lSph;
                var $cyl = isRight ? $rCyl : $lCyl;
                var $axis = isRight ? $rAxis : $lAxis;
                var $add = isRight ? $rAdd : $lAdd;
                var $dia = isRight ? $rDia : $lDia;
                var $dc = isRight ? $rDc : $lDc;
                var $position = isRight ? $rPosition : $lPosition;
                var $prism = isRight ? $rPrism : $lPrism;
                var $basePrism = isRight ? $rBasePrism : $lBasePrism;
                var $ipd = isRight ? $ipdr : $ipdl;
                var $sphSigned = isRight ? $rSphSignedValue : $lSphSignedValue;
                var $cylSigned = isRight ? $rCylSignedValue : $lCylSignedValue;

                var sphSigned = String($sphSigned.val() || "").trim();
                var cylSigned = String($cylSigned.val() || "").trim();
                var addText = getSelectedText($add).replace(",", ".");
                var diaText = String($dia.val() || "").trim();
                var dcText = String($dc.val() || "").trim();
                var prismText = String($prism.val() || "").trim();
                var basePrismText = String($basePrism.val() || "").trim();
                var positionText = String($position.val() || "").trim();

                return {
                    IsRight: isRight ? 1 : 0,
                    Quantity: 1,
                    DefineObjectId: defineObjectId,
                    ConsumerTitle: trimToMaxLength(consumer, 20),
                    Optician: trimToMaxLength(storeName, 254),
                    NeedTools: needTools,
                    Axis: parseNullableInt($axis.val()),
                    ItemAdd: parseNullableScaledShort(addText),
                    Dia: parseNullableInt($dia.val()),
                    Dc: parseNullableInt($dc.val()),
                    Ipd: parseNullableNumber($ipd.val()),
                    Prism: parseNullableScaledShort($prism.val()),
                    BaseOfPrism: mapBasePrismCode(basePrismText),
                    Position: mapPositionCode(positionText),
                    Description: trimToMaxLength(buildEyeMeta({
                        SPH: sphSigned,
                        CYL: cylSigned,
                        ADD: addText,
                        DIA: diaText,
                        DC: dcText,
                        PRISM: prismText,
                        BASE: basePrismText,
                        POSITION: positionText
                    }), 254)
                };
            }

            function appendEyeItemToPayload(payload, index, item) {
                Object.keys(item || {}).forEach(function (key) {
                    var value = item[key];
                    if (value === undefined || value === null) {
                        return;
                    }
                    var text = typeof value === "string" ? value.trim() : value;
                    if (text === "") {
                        return;
                    }
                    payload["TblLnsOrderItems[" + index + "]." + key] = value;
                });
            }

            function buildCustomOrderPayload() {
                applySelectedCustomerIdFromText();

                syncSphSignedValue("r");
                syncSphSignedValue("l");
                syncCylSignedValue("r");
                syncCylSignedValue("l");

                var payload = {
                    DefineCustomerId: parseNullableInt($defineCustomerId.val()),
                    StoreName: trimToMaxLength(String($("#StoreName").val() || "").trim(), 254),
                    Consumer: trimToMaxLength(String($("#Consumer").val() || "").trim(), 254),
                    BrandId: parseNullableInt($brand.val()),
                    LensTypeId: parseNullableInt($lensType.val()),
                    DesignTypeId: parseNullableInt($designType.val()),
                    LensIndexId: parseNullableInt($lensIndex.val()),
                    MaterialTypeId: parseNullableInt($materialType.val()),
                    DefineObjectId: parseNullableInt($product.val()),
                    CoatingId: parseNullableInt($coating.val()),
                    Corridor: parseCorridorValue($corridor.val()),
                    BeforeLensSpec: trimToMaxLength(String($("#BeforeLensSpec").val() || "").trim(), 20),
                    BeforeLensType: parseNullableInt($("input[name='BeforeLensType']:checked").val()),
                    Description: trimToMaxLength(buildOrderMeta(), 254),
                    HBox: parseNullableNumber($hBox.val()),
                    VBox: parseNullableNumber($vBox.val()),
                    FittingR: parseNullableNumber($("#FITTINGR").val()),
                    FittingL: parseNullableNumber($("#FITTINGL").val()),
                    Dbl: parseNullableNumber($dbl.val()),
                    EffectiveDiameter: parseNullableNumber($ed.val()),
                    Panto: parseNullableNumber($("#PANTO").val()),
                    Ffa: parseNullableNumber($("#FFA").val()),
                    Vd: parseNullableNumber($("#BVD").val()),
                    IpdR: parseNullableNumber($ipdr.val()),
                    IpdL: parseNullableNumber($ipdl.val()),
                    FrameTypeId: parseNullableInt($frameType.val()),
                    ColoringTypeId: parseNullableInt($coloringType.val()),
                    Color: trimToMaxLength(String($color.val() || "").trim(), 254),
                    ColorRatio: parseNullableNumber($colorRatio.val()),
                    ColorRatioTop: parseNullableNumber($topRatio.val()),
                    ColorBottom: parseNullableNumber($bottomRatio.val())
                };

                var needTools = String($extraService.val() || "").trim().toUpperCase() === "TOOLS";
                var rightEyeItem = buildEyeItem(true, payload.DefineObjectId, payload.Consumer, payload.StoreName, needTools);
                var leftEyeItem = buildEyeItem(false, payload.DefineObjectId, payload.Consumer, payload.StoreName, needTools);
                appendEyeItemToPayload(payload, 0, rightEyeItem);
                appendEyeItemToPayload(payload, 1, leftEyeItem);

                return payload;
            }

            function validateCustomOrderPayload(payload) {
                if (!payload.DefineCustomerId) {
                    toastr.error("مشتری را انتخاب کنید.", "");
                    return false;
                }
                if (!payload.BrandId || !payload.LensTypeId || !payload.DesignTypeId || !payload.LensIndexId || !payload.MaterialTypeId || !payload.DefineObjectId) {
                    toastr.error("مشخصات محصول کامل نیست.", "");
                    return false;
                }
                return true;
            }

            function submitCustomLensOrder(isSend) {
                syncCustomerFieldVisualState();

                if (!validateAxisRules() || !validatePositionRules() || !validateBasePrismRules() || !validateFrameByDiaRules() || !validateColoringTypeRules()) {
                    return;
                }

                var payload = buildCustomOrderPayload();
                if (!validateCustomOrderPayload(payload)) {
                    return;
                }

                var url = isSend
                    ? '@Url.Action("CustomLensOrderSend", "Orders")'
                    : '@Url.Action("CustomLensOrder", "Orders")';

                var $buttons = $('[data-kt-element="save-custom-order"], [data-kt-element="save-send-custom-order"]');
                $buttons.prop("disabled", true);

                $.post(url, payload)
                    .done(function (result) {
                        if (result && result.success) {
                            toastr.success("", "سفارش با موفقیت ثبت شد.");
                            location.reload();
                        } else {
                            toastr.error((result && result.message) ? result.message : "خطا در ثبت سفارش.", "");
                        }
                    })
                    .fail(function () {
                        toastr.error("خطا در ثبت سفارش.", "");
                    })
                    .always(function () {
                        $buttons.prop("disabled", false);
                    });
            }

            $('[data-kt-element="save-custom-order"]').off("click.customlenssave").on("click.customlenssave", function () {
                submitCustomLensOrder(false);
            });

            $('[data-kt-element="save-send-custom-order"]').off("click.customlenssave").on("click.customlenssave", function () {
                submitCustomLensOrder(true);
            });

            $(document).on("click", "[data-toggle='sph'], [data-toggle='cyl']", function () {
                var $btn = $(this);
                if ($btn.prop("disabled")) {
                    return;
                }
                var isPlus = $btn.hasClass("eye-plus");
                if (isPlus) {
                    $btn.removeClass("eye-plus").text("-");
                } else {
                    $btn.addClass("eye-plus").text("+");
                }
                if ($btn.data("toggle") === "sph") {
                    var eye = ($btn.data("eye") || "").toString().toLowerCase();
                    if (eye === "r" || eye === "l") {
                        syncSphSignedValue(eye);
                    }
                }
                if ($btn.data("toggle") === "cyl") {
                    var eyeCyl = ($btn.data("eye") || "").toString().toLowerCase();
                    if (eyeCyl === "r" || eyeCyl === "l") {
                        syncCylSignedValue(eyeCyl);
                    }
                }
            });

            window.ValidateCustomLensAxis = validateAxisRules;

            $("#customLensOrderForm").on("submit.customLensAxisValidation", function (e) {
                if (!validateAxisRules() || !validatePositionRules() || !validateBasePrismRules() || !validateFrameByDiaRules() || !validateColoringTypeRules()) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    return false;
                }
                return true;
            });
        });
    </script>
}

