            function captureScrollState($el) {
                var state = {
                    pageX: window.pageXOffset || 0,
                    pageY: window.pageYOffset || 0,
                    containers: []
                };
                $el.parents().each(function () {
                    var el = this;
                    var style = window.getComputedStyle(el);
                    var overflowY = style.overflowY;
                    if ((overflowY === "auto" || overflowY === "scroll") && el.scrollHeight > el.clientHeight) {
                        state.containers.push({ el: el, top: el.scrollTop, left: el.scrollLeft });
                    }
                });
                return state;
            }

            function restoreScrollState(state) {
                if (!state) {
                    return;
                }
                state.containers.forEach(function (item) {
                    item.el.scrollTop = item.top;
                    item.el.scrollLeft = item.left;
                });
                var currentX = window.pageXOffset || 0;
                var currentY = window.pageYOffset || 0;
                if (Math.abs(currentX - state.pageX) > 1 || Math.abs(currentY - state.pageY) > 1) {
                    window.scrollTo(state.pageX, state.pageY);
                }
            }

            function openSelectFromHover($el) {
                if ($el.prop("disabled")) {
                    return;
                }
                if ($el.data("select2") && $el.data("select2").isOpen && $el.data("select2").isOpen()) {
                    return;
                }
                if ((Date.now() - lastWindowScrollAt) < 180) {
                    return;
                }

                var scrollState = captureScrollState($el);
                $(".select2-hidden-accessible").not($el).each(function () {
                    var $other = $(this);
                    if ($other.data("select2")) {
                        $other.select2("close");
                    }
                });
                $el.select2("open");

                // Select2 focuses its search input on open; keep viewport stable.
                setTimeout(function () { restoreScrollState(scrollState); }, 0);
                requestAnimationFrame(function () { restoreScrollState(scrollState); });
            }

