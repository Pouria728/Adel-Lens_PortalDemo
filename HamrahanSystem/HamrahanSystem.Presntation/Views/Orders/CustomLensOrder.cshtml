@section scripts
{
    <script>
        $(function () {
            function resolveDropdownParent($el) {
                var $modal = $el.closest(".modal, .modal-content");
                if ($modal.length) {
                    return $modal;
                }
                var $sectionBody = $el.closest(".section-body");
                if ($sectionBody.length) {
                    return $sectionBody;
                }
                var $customCard = $el.closest(".custom-lens-order");
                if ($customCard.length) {
                    return $customCard;
                }
                return $(document.body);
            }

            function destroySelect2IfNeeded($el) {
                if ($el.hasClass("select2-hidden-accessible")) {
                    $el.select2("destroy");
                }
            }

            $(".custom-lens-order select").each(function () {
                var $select = $(this);
                destroySelect2IfNeeded($select);
                // Keep all dropdowns native in this form.
                $select.removeAttr("data-control");
                $select.removeAttr("data_control");
                $select.removeAttr("data-kt-initialized");
            });

            function getSelect2Dropdown($el) {
                var instance = $el.data("select2");
                if (instance && instance.$dropdown && instance.$dropdown.length) {
                    return instance.$dropdown;
                }
                return $(".select2-container--open .select2-dropdown");
            }

            var $defineCustomerId = $("#DefineCustomerId");
            var $defineCustomerSearch = $("#DefineCustomerSearch");
            var $defineCustomerSearchList = $("#DefineCustomerSearchList");
            var customerSearchTimer = null;
            var customerSearchRequest = null;
            var customerSearchToken = 0;

            function readCustomerItemId(item) {
                if (!item || typeof item !== "object") {
                    return "";
                }
                var idKeys = ["id", "Id", "value", "Value", "defineCustomerId", "DefineCustomerId", "defineObjectId", "DefineObjectId"];
                for (var i = 0; i < idKeys.length; i++) {
                    var idKey = idKeys[i];
                    if (Object.prototype.hasOwnProperty.call(item, idKey) && item[idKey] != null && String(item[idKey]).trim() !== "") {
                        return String(item[idKey]).trim();
                    }
                }
                return "";
            }

            function readCustomerItemText(item) {
                if (!item || typeof item !== "object") {
                    return "";
                }
                var textKeys = ["text", "Text", "name", "Name", "nameFormal", "NameFormal"];
