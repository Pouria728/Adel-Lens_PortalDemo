                @Html.Label("نقش کاربر", "نقش کاربر", htmlAttributes: new { @class = "col-lg-2 col-form-label fw-semibold fs-6" })
                <div class="col-md-4">
                    <input type="hidden" id="UserRoles_0__RoleId" name="UserRoles[0].RoleId" value="@(selectedRoleId > 0 ? selectedRoleId.ToString() : "")" />
                    <input type="text" id="UserRoleSearch" class="form-control form-control-solid form-control-lg" placeholder="نقش کاربر" autocomplete="off" list="UserRoleSearchList" value="@selectedRoleName" />
                    <datalist id="UserRoleSearchList"></datalist>
                    @* @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" }) *@
                </div>
                @Html.Label(ResourcePages.UserName, ResourcePages.UserName, htmlAttributes: new { @class = "col-lg-2 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.Username, new { htmlAttributes = new { @class = "form-control form-control-lg form-control-solid" } })
                    @* @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" }) *@
                </div>
            </div>
            <div class="form-group row mb-6">
                @Html.Label(ResourcePages.Password, ResourcePages.Password, htmlAttributes: new { @class = "col-lg-2 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.PasswordHash, new { htmlAttributes = new { @class = "form-control form-control-lg form-control-solid" } })
                    @* @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" }) *@
                </div>
                @Html.Label(ResourcePages.RePassword, ResourcePages.RePassword, htmlAttributes: new { @class = "col-lg-2 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.PasswordHash, new { htmlAttributes = new { @class = "form-control form-control-lg form-control-solid" } })
