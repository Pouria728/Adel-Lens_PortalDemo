@model HamrahanSystem.Application.DTOs.UserDto

@{
    ViewBag.Title = "";
    Layout = null;
    var selectedRoleId = 0;
    var selectedRoleName = "";
    if (Model.UserRoles != null && Model.UserRoles.Count > 0)
    {
        selectedRoleId = Model.UserRoles[0].RoleId;
    }
    if (ViewBag.ListRole != null)
    {
        foreach (var role in ViewBag.ListRole)
        {
            if (selectedRoleId == 0 || role.RoleId == selectedRoleId)
            {
                selectedRoleId = role.RoleId;
                selectedRoleName = role.RoleName ?? "";
                break;
            }
        }
    }
}



@using (Html.BeginForm("Create", "TaxPayerCustomers", FormMethod.Post, new { @id = "form-TaxPayerCustomers" }))
{
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-header bg-light-primary"><h3 class="card-title align-items-start flex-column">@($"{ResourcePages.Add} {ResourcePages.Users}")</h3> </div>
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="form-group row mb-6 ">
                @Html.Label(ResourcePages.FirstName, ResourcePages.FirstName, htmlAttributes: new { @class = "col-lg-2 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @class = "form-control form-control-lg form-control-solid" } })
                    @* @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" }) *@
                </div>
                @Html.Label(ResourcePages.LastName, ResourcePages.LastName, htmlAttributes: new { @class = "col-lg-2 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control form-control-lg form-control-solid" } })
                    @* @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" }) *@
                </div>
            </div>
            
            <div class="form-group row mb-6">
                @Html.Label(ResourcePages.Mobile, ResourcePages.Mobile, htmlAttributes: new { @class = "col-lg-2 col-form-label fw-semibold fs-6" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.MobilePhoneNumber, new { htmlAttributes = new { @class = "form-control form-control-lg form-control-solid" } })
                    @* @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" }) *@
                </div>
                @Html.Label(ResourcePages.CustomerId, ResourcePages.CustomerId, htmlAttributes: new { @class = "col-lg-2 col-form-label fw-semibold fs-6" })
