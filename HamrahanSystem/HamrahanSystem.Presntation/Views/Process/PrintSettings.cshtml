@model HamrahanSystem.Presntation.Models.CustomLensPrintSettingsViewModel
@{
    ViewBag.Title = "";
    var scopeTitle = ViewBag.PrintSettingsScopeTitle as string ?? "تنظیمات چاپ خودکار عدسی سفارشی";
    var processName = ViewBag.PrintSettingsProcessName as string ?? string.Empty;
    var returnUrl = !string.IsNullOrWhiteSpace(Model.ReturnUrl) && Url.IsLocalUrl(Model.ReturnUrl)
        ? Model.ReturnUrl
        : Url.Action("Index", "Process");
}

<div class="card">
    <div class="card-header bg-primary">
        <h3 class="card-title align-items-start flex-column">@scopeTitle</h3>
    </div>
    <div class="card-body">
        @if (TempData["PrintSettingsError"] is string error && !string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger">@error</div>
        }
        @if (TempData["PrintSettingsSaved"] is string message && !string.IsNullOrWhiteSpace(message))
        {
            <div class="alert alert-success">@message</div>
        }
        @if (Model.ProcessId.HasValue && !string.IsNullOrWhiteSpace(processName))
        {
            <div class="alert alert-info mb-4">
                فرآیند: <strong>@processName</strong>
                @if (Model.ProcessStepId.HasValue)
                {
                    <span class="ms-2">(تنظیم گام: @Model.ProcessStepId)</span>
                }
            </div>
        }

        <form method="post" asp-action="PrintSettings" asp-controller="Process">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.ProcessId)
            @Html.HiddenFor(x => x.ProcessStepId)
            @Html.HiddenFor(x => x.ReturnUrl)

            <div class="mb-4 form-check form-switch">
                <input asp-for="IsEnabled" class="form-check-input" />
                <label asp-for="IsEnabled" class="form-check-label">فعال‌سازی چاپ خودکار هنگام ثبت و ارسال عدسی سفارشی</label>
            </div>

            <div class="mb-4">
                <label asp-for="ReportUrlTemplate" class="form-label">آدرس گزارش چاپ</label>
                <input asp-for="ReportUrlTemplate" class="form-control form-control-solid" dir="ltr" />
                <small class="form-text text-muted">
                    از متغیرهای <code>{orderId}</code>، <code>{factorNo}</code> و <code>{printer}</code> می‌توانید داخل آدرس استفاده کنید.
                </small>
            </div>

            <div class="mb-4">
                <label asp-for="PrinterNamesText" class="form-label">لیست پرینترها</label>
                <textarea asp-for="PrinterNamesText" class="form-control form-control-solid" rows="6" dir="ltr"></textarea>
                <small class="form-text text-muted">
                    هر پرینتر را در یک خط جدا وارد کنید.
                </small>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-primary">ذخیره تنظیمات</button>
                <a class="btn btn-light ms-2" href="@returnUrl">بازگشت</a>
            </div>
        </form>
    </div>
</div>
