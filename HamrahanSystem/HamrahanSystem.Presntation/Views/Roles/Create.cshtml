@model HamrahanSystem.Application.DTOs.RoleDto

@{
    ViewBag.Title = "";
    Layout = null;
}



@using (Html.BeginForm("Create", "TaxPayerCustomers", FormMethod.Post, new { @id = "form-TaxPayerCustomers" }))
{
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-header bg-light-primary"><h3 class="card-title align-items-start flex-column">@($"{ResourcePages.Add} {ResourcePages.Roles}")</h3> </div>
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="form-group row mb-6 ">
                @Html.Label(ResourcePages.Base_Name, ResourcePages.Base_Name, htmlAttributes: new { @class = "col-lg-4 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.RoleName, new { htmlAttributes = new { @class = "form-control form-control-lg form-control-solid" } })
                    @* @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" }) *@
                </div>
            </div>
            <div class="form-group row">
                @Html.Label("test","", htmlAttributes: new { @class = "col-form-label col-md-10" })

            </div>
            <div class="form-group row  border border-2 ">
                @Html.ListBox("permission", new MultiSelectList(ViewBag.ListPermission, "PermissionId", "Title"), new {Id="permission", multiple = "multiple", @class = "form-control" })
                @Html.ValidationMessage("permission", new { @class = "text-danger" })
            </div>
            
            



            <div class="form-group text-center mb-4">
                <input type="button" id="create-btn" value="@($"{ResourcePages.Save} {ResourcePages.Roles}")" class="btn btn-success" />

            </div>
        </div>
    </div>
}
<script type="text/javascript">

    $(function () {
            localStorage.clear();

        $("#permission").bootstrapDualListbox({
            nonSelectedListLabel: 'نقش های قابل تخصیص',
            selectedListLabel: 'نقش های اختصاص یافته',
            moveOnSelect: false
        });
         $(document).off("click", "#create-btn")
             .on("click", "#create-btn", function () {
                 $form = $("#form-TaxPayerCustomers");

                 $.post('@Url.Action("Create", "Roles")',
                     $form.serialize()

                 )
                     .done(function (result) {

                         if (result.success) {
                             toastr.success("", '@ResourceAlert.AddSucces');
                            LoadItems();
                         } else {
                             toastr.error('@ResourceAlert.AddError', result.message);
                         }


                     }).fail(function () { toastr.error('@ResourceAlert.AddError', '') });
         });
    });


</script>
