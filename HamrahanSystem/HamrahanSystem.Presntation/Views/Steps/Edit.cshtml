@model HamrahanSystem.Application.DTOs.TblWfwProcessStepDto

@{
    ViewBag.Title = "";
    Layout = null;
    var processIdValue = Model?.ProcessId ?? Model?.TblWfwProcess?.ProcessId ?? 0;
    var processNameValue = Model?.TblWfwProcess?.Name ?? (ViewBag.ProcessName as string) ?? string.Empty;
}



@using (Html.BeginForm("Edit", "TaxPayerCustomers", FormMethod.Post, new { @id = "form-TaxPayerCustomers" }))
{
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-header bg-warning"><h2 class="card-title align-items-start flex-column">@($"{ResourcePages.Edit} {ResourcePages.Steps}")</h2> </div>
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.ProcessStepId, Model.ProcessStepId)
            @Html.HiddenFor(model => model.ProcessId, processIdValue)
            <div class="form-group row mb-6 ">
                @Html.Label(ResourcePages.Base_Process, ResourcePages.Base_Process, htmlAttributes: new { @class = "col-lg-4 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    @Html.Label("TblWfwProcess", processNameValue, new { @class = "form-control form-control-lg form-control-solid" })
                    @* @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" }) *@
                </div>
            </div>
            <div class="form-group row mb-6 ">
                @Html.Label(ResourcePages.Base_Name, ResourcePages.Base_Name, htmlAttributes: new { @class = "col-lg-4 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control form-control-lg form-control-solid" } })
                    @* @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" }) *@
                </div>
            </div>
            <div class="form-group row mb-6 ">
                @Html.Label(ResourcePages.Base_Code, ResourcePages.Base_Code, htmlAttributes: new { @class = "col-lg-4 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.Code, new { htmlAttributes = new { @class = "form-control form-control-lg form-control-solid" } })
                    @* @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" }) *@
                </div>
            </div>

            <div class="form-group row mb-6">
                @Html.Label(ResourcePages.Base_IsPrint, ResourcePages.Base_IsPrint, htmlAttributes: new { @class = "col-lg-4 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    <div class="checkbox">
                        @Html.CheckBoxFor(model => model.IsPrint, htmlAttributes: new { @checked = true, @class = "form-check-input" })
                        @*              @Html.ValidationMessageFor(model => model.Ip, "", new { @class = "text-danger" }) *@
                    </div>
                </div>
            </div>
            <div class="form-group row mb-6">
                @Html.Label(ResourcePages.Base_IsBarcode, ResourcePages.Base_IsBarcode, htmlAttributes: new { @class = "col-lg-4 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    <div class="checkbox">
                        @Html.CheckBoxFor(model => model.IsBarcode, htmlAttributes: new { @checked = true, @class = "form-check-input" })
                        @*              @Html.ValidationMessageFor(model => model.Ip, "", new { @class = "text-danger" }) *@
                    </div>
                </div>
            </div>
            <div class="form-group row mb-6 ">
                @Html.Label(ResourcePages.Base_ProcedureId, ResourcePages.Base_ProcedureId, htmlAttributes: new { @class = "col-lg-4 col-form-label fw-semibold fs-6" })
                <div class="col-md-4">
                    @Html.DropDownListFor(model => model.ProcedureId, (List<SelectListItem>)ViewBag.ListProcedure, new { @class = "form-select form-select-solid form-select-lg ", aria_label = "", data_control = "select2", data_placeholder = "", data_dropdown_parent = "#modal-Tree" })
                    @* @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" }) *@
                </div>
            </div>
            <div class="form-group row mb-6">
                @Html.Label(ResourcePages.Base_IsActive, ResourcePages.Base_IsActive, htmlAttributes: new { @class = "col-lg-4 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    <div class="checkbox">
                        @Html.CheckBoxFor(model => model.IsActive, htmlAttributes: new { @checked = true, @class = "form-check-input" })
                        @*              @Html.ValidationMessageFor(model => model.Ip, "", new { @class = "text-danger" }) *@
                    </div>
                </div>
            </div>
            <div class="form-group row mb-6">
                @Html.Label(ResourcePages.Base_OrderId, ResourcePages.Base_OrderId, htmlAttributes: new { @class = "col-lg-4 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.OrderId, new { htmlAttributes = new { @class = "form-control form-control-lg form-control-solid" } })
                    @* @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" }) *@
                </div>
            </div>
            <div class="form-group row">
                @Html.Label("test", "", htmlAttributes: new { @class = "col-form-label col-md-10" })

            </div>
            <div class="form-group row  border border-2 ">
                @Html.ListBox("role", new MultiSelectList(ViewBag.ListRole, "RoleId", "RoleName", Model.TblWfwRoleStepes?.Select(y => y.RoleId)), new { multiple = "multiple", @class = "form-control" })
                @Html.ValidationMessage("Role", new { @class = "text-danger" })
            </div>
            <div class="form-group row mt-6 border border-2">
                @Html.ListBox("nextStep", new MultiSelectList(ViewBag.NextStepOptions, "Value", "Text", ViewBag.SelectedNextStepIds), new { multiple = "multiple", @class = "form-control" })
                @Html.ValidationMessage("nextStep", new { @class = "text-danger" })
            </div>
            @Html.Hidden("nextStepResultConfig", "", new { id = "nextStepResultConfig" })
            <div class="form-group row mt-6">
                @Html.Label("nextStepResultConfigView", "گزینه اجباری انتقال برای هر گام", htmlAttributes: new { @class = "col-lg-4 col-form-label fw-semibold fs-6" })
                <div class="col-md-8">
                    <div id="next-step-result-config" class="border border-2 rounded p-3"></div>
                </div>
            </div>



            <div class="form-group text-center mb-4">
                <input type="button" id="create-btn" value="@($"{ResourcePages.Save} {ResourcePages.Steps}")" class="btn btn-success" />

            </div>
        </div>
    </div>
}
<script type="text/javascript">

    $(function () {
            localStorage.clear();
        var nextStepResultMap = @Html.Raw(ViewBag.NextStepResultMapJson ?? "{}");
        if (!nextStepResultMap || typeof nextStepResultMap !== "object") {
            nextStepResultMap = {};
        }

        $("#role").bootstrapDualListbox({
            nonSelectedListLabel: 'نقش های قابل تخصیص',
            selectedListLabel: 'نقش های اختصاص یافته',
            moveOnSelect: false
        });
        $("#nextStep").bootstrapDualListbox({
            nonSelectedListLabel: 'گام های قابل انتخاب',
            selectedListLabel: 'گام های بعدی این مرحله',
            moveOnSelect: false
        });
        function getSelectedNextStepOptions() {
            var result = {};
            $("#nextStep option:selected").each(function () {
                var stepId = ($(this).val() || "").toString();
                if (!stepId) {
                    return;
                }
                result[stepId] = ($(this).text() || "").trim();
            });
            return result;
        }

        function getDistinctValues(values) {
            var seen = {};
            var list = [];
            (values || []).forEach(function (value) {
                var normalized = (value || "").trim();
                if (!normalized) {
                    return;
                }
                var key = normalized.toLowerCase();
                if (seen[key]) {
                    return;
                }
                seen[key] = true;
                list.push(normalized);
            });
            return list;
        }

        function appendOptionRow(stepId, value) {
            var escapedValue = $("<div/>").text(value || "").html();
            var rowHtml = '' +
                '<div class="input-group input-group-sm mb-2 result-option-row">' +
                '  <input type="text" maxlength="100" class="form-control result-option-input" value="' + escapedValue + '" placeholder="گزینه پاپ‌آپ">' +
                '  <button type="button" class="btn btn-light-danger btn-remove-result-option" data-step-id="' + stepId + '">' +
                '    <i class="fa fa-times"></i>' +
                '  </button>' +
                '</div>';
            $("#result-options-" + stepId).append(rowHtml);
        }

        function renderNextStepResultConfig() {
            var selectedMap = getSelectedNextStepOptions();
            var selectedStepIds = Object.keys(selectedMap);
            var container = $("#next-step-result-config");
            container.empty();

            if (!selectedStepIds.length) {
                container.append('<div class="text-muted">ابتدا گام بعدی را انتخاب کنید.</div>');
                return;
            }

            selectedStepIds.forEach(function (stepId) {
                var title = $("<div/>").text(selectedMap[stepId]).html();
                var cardHtml = '' +
                    '<div class="border rounded p-3 mb-3">' +
                    '  <div class="d-flex justify-content-between align-items-center mb-2">' +
                    '    <strong>' + title + '</strong>' +
                    '    <button type="button" class="btn btn-sm btn-light-primary btn-add-result-option" data-step-id="' + stepId + '">' +
                    '      افزودن گزینه' +
                    '    </button>' +
                    '  </div>' +
                    '  <div id="result-options-' + stepId + '"></div>' +
                    '</div>';
                container.append(cardHtml);

                var options = getDistinctValues(nextStepResultMap[stepId]);
                if (!options.length) {
                    appendOptionRow(stepId, "");
                } else {
                    options.forEach(function (option) {
                        appendOptionRow(stepId, option);
                    });
                }
            });
        }

        function collectNextStepResultConfig() {
            var selectedMap = getSelectedNextStepOptions();
            var config = {};

            Object.keys(selectedMap).forEach(function (stepId) {
                var values = [];
                $("#result-options-" + stepId + " .result-option-input").each(function () {
                    values.push($(this).val());
                });
                var uniqueValues = getDistinctValues(values);
                if (uniqueValues.length) {
                    config[stepId] = uniqueValues;
                }
            });

            return config;
        }

        $(document).off("change", "#nextStep").on("change", "#nextStep", function () {
            renderNextStepResultConfig();
        });

        $(document).off("click", ".btn-add-result-option").on("click", ".btn-add-result-option", function () {
            var stepId = $(this).data("step-id");
            appendOptionRow(stepId, "");
        });

        $(document).off("click", ".btn-remove-result-option").on("click", ".btn-remove-result-option", function () {
            var stepId = $(this).data("step-id");
            var container = $("#result-options-" + stepId);
            $(this).closest(".result-option-row").remove();
            if (!container.find(".result-option-row").length) {
                appendOptionRow(stepId, "");
            }
        });

        renderNextStepResultConfig();

         $(document).off("click", "#create-btn")
             .on("click", "#create-btn", function () {
                 $form = $("#form-TaxPayerCustomers");
                 var config = collectNextStepResultConfig();
                 $("#nextStepResultConfig").val(JSON.stringify(config));

                 $.post('@Url.Action("Edit", "Steps")',
                     $form.serialize()

                 )
                     .done(function (result) {

                         if (result.success) {
                             toastr.success("", '@ResourceAlert.AddSucces');
                            LoadItems();
                         } else {
                             toastr.error('@ResourceAlert.AddError', result.message);
                         }


                     }).fail(function () { toastr.error('@ResourceAlert.AddError', '') });
         });
    });

</script>
