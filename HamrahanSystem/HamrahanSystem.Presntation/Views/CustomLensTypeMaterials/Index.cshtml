@{
    ViewBag.Title = "";
    string BasePage = "CustomLensTypeMaterials";
    var embedded = ViewBag.Embedded as bool? ?? false;
    if (embedded)
    {
        Layout = "~/Views/Shared/_Layout_CustomLensEmbedded.cshtml";
    }
    var designTypeId = ViewBag.DesignTypeId ?? 0;
    var lensIndexId = ViewBag.LensIndexId ?? 0;
}

@await Html.PartialAsync("_CustomLensPremiumGridStyle")

<div class="card custom-lens-premium">
    <div class="card-header bg-primary" style="display:flex;justify-content:flex-start;direction:ltr;">
        <h3 class="card-title mb-0" style="margin:0 !important;text-align:left !important;">Material</h3>
    </div>
    <div class="card-body">
        <div class="form-group" id="divjqGrid">
            <table id="jqGrid" class="table table-striped"></table>
            <div id="jqGridPager"></div>
        </div>

        <div class="form-group text-center mb-4">
            @if ((designTypeId is int didBtn && didBtn > 0) || (lensIndexId is int lidBtn && lidBtn > 0))
            {
                <input type="button" id="custom-material-create-btn" class="btn btn-primary" value="À»  œ” Ì" onclick="LoadDialog(0,1)" />
                <input type="button" id="custom-material-import-btn" class="btn btn-success" value="«Ì„ÅÊ—  «ò”·" />
                <input type="button" id="custom-material-export-btn" class="btn btn-light-primary" value="«ò”ÅÊ—  «ò”·" />
                <input type="file" id="custom-material-import-file" class="d-none" accept=".xlsx,.xls" />
                <div class="small text-muted mt-2"> — Ì» ” Ê‰ùÂ«: ò«·«Ì «‰»«—° Material°  — Ì» ‰„«Ì‘° Ê÷⁄Ì  («Œ Ì«—Ì)</div>
                <div id="custom-material-import-errors" class="alert alert-danger mt-3 d-none text-start" dir="rtl"></div>
            }
            else
            {
                <div class="small text-muted mt-2">»—«Ì À»  Material «» œ« Lens Index —« «‰ Œ«» ò‰Ìœ.</div>
            }
        </div>
    </div>
</div>

<script type="text/javascript">
    var embeddedMode = @(embedded ? "true" : "false");
    var embeddedQuery = embeddedMode ? '&embedded=1' : '';
    var designTypeId = @designTypeId;
    var lensIndexId = @lensIndexId;

    (function resolveContextFromQuery() {
        try {
            var qs = new URLSearchParams(window.location.search);
            var qsLensIndexId = parseInt(qs.get('lensIndexId') || '0', 10);
            if (!lensIndexId && qsLensIndexId > 0) {
                lensIndexId = qsLensIndexId;
            }
            var qsDesignTypeId = parseInt(qs.get('designTypeId') || '0', 10);
            if (!designTypeId && qsDesignTypeId > 0) {
                designTypeId = qsDesignTypeId;
            }
        } catch (e) {
        }
    })();

    function LoadDialog(nodeId, typeId) {
        var url = '';
        switch (typeId) {
            case 1: url = '@Url.Action("Create", BasePage)';
                break;
            case 2: url = '@Url.Action("Edit", BasePage)';
                break;
            case 3: url = '@Url.Action("Delete", BasePage)';
                break;
        }

        if (typeId != 3) {
            $.get(url, typeId >= 1 ? { id: nodeId, designTypeId: designTypeId, lensIndexId: lensIndexId } : {})
                .done(function (result) {
                    $("#modal-loader").html(result);
                    $("#modal-Tree").modal('show');
                }).fail(function (xhr) {
                    if (xhr && xhr.status === 403) {
                        toastr.error('œ” —”Ì ÊÌ—«Ì‘ ‰œ«—Ìœ.', '');
                    } else if (xhr && xhr.status === 404) {
                        toastr.error('—òÊ—œ „Ê—œ‰Ÿ— Ì«›  ‰‘œ.', '');
                    } else {
                        toastr.error('@ResourceAlert.AddError', '');
                    }
                });
        }
        else {
            if (typeId == 3) {
                $.post(url, { id: nodeId, designTypeId: designTypeId, lensIndexId: lensIndexId })
                    .done(function (result) {
                        if (result.success) {
                            toastr.success("", '@ResourceAlert.RemoveSuccess');
                            LoadItems();
                        } else {
                            toastr.error('@ResourceAlert.AddError', result.message);
                        }
                    }).fail(function (xhr) {
                        if (xhr && xhr.status === 403) {
                            toastr.error('œ” —”Ì Õ–› ‰œ«—Ìœ.', '');
                        } else if (xhr && xhr.status === 404) {
                            toastr.error('—òÊ—œ „Ê—œ‰Ÿ— Ì«›  ‰‘œ.', '');
                        } else {
                            toastr.error('@ResourceAlert.AddError', '');
                        }
                    });
                return;
            }
        }
        $(document).resize();
    }

    function LoadItems() {
        $('#modal-Tree').modal('hide');
        $.jgrid.defaults.responsive = true;
        $.jgrid.defaults.styleUI = 'Bootstrap';

        var detailUrl = '@Url.Action("Detail", BasePage)';
        $('#jqGrid').jqGrid({
            url: detailUrl + '?designTypeId=' + designTypeId + '&lensIndexId=' + lensIndexId + embeddedQuery,
            datatype: 'json',
            mtype: 'POST',
            serializeGridData: function (postData) {
                var data = {
                    designTypeId: designTypeId,
                    lensIndexId: lensIndexId
                };
                postData._search = true;
                data = $.extend(data, postData);
                return JSON.stringify(data);
            },

            colNames: ['@ResourceCustomLensTypeMaterials.Column_Id', '@ResourceCustomLensTypeMaterials.Column_LensType', '@ResourceCustomLensTypeMaterials.Column_Material', '@ResourceCustomLensTypeMaterials.Column_InventoryItem', '@ResourceCustomLensTypeMaterials.Column_OrderId', '@ResourceCustomLensTypeMaterials.Column_IsActive', '@ResourceCustomLensTypeMaterials.Column_EditDelete'],
            colModel: [
                { name: 'id', index: 'id', align: "Center", hidden: true, key: true, search: false },
                { name: 'lensTypeName', index: 'lensTypeName', align: "Center", sortable: false, search: false },
                { name: 'materialName', index: 'materialName', align: "Center", sortable: true, search: true },
                { name: 'defineObjectText', index: 'defineObjectText', align: "Center", sortable: false, search: false },
                { name: 'orderId', index: 'orderId', align: "Center", sortable: false, search: false },
                { name: 'isActive', index: 'isActive', align: "Center", sortable: false, search: false },
                {
                    name: 'id', index: 'Action', align: "Center", sortable: false, search: false,
                    formatter: function (value, rowData, index) {
                        var a = '<button type="button" title="@ResourcePages.Edit" onclick="LoadDialog(\'' + value + '\',2);"><i class="fa fa-2x fa-pen"></i> </button> ';
                        a += '<button type="button" title="@ResourcePages.Delete" onclick="LoadDialog(\'' + value + '\',3);"><i class="fa fa-2x fa-trash"></i> </button> ';
                        return a;
                    }
                }
            ],
            subGridRowExpanded: function (subgrid_id, row_id) { },
            subGridRowColapsed: function (subgrid_id, row_id) { },
            subgroup: true,
            rowNum: 20,
            toppager: false,
            height: 300,
            direction: 'rtl',
            rowList: [10, 20, 30, 40],
            viewrecords: true,
            gridview: true,
            altRows: true,
            hidegrid: false,
            rownumbers: true,
            recordpos: 'left',
            multiselect: false,
            scroll: true,
            scrollrows: false,
            jsonReader: {
                page: function (obj) { return obj.page; },
                total: function (obj) { return obj.total; },
                records: function (obj) { return obj.records; },
                root: function (obj) { return obj.rows; },
                repeatitems: false,
                id: "0"
            },
            pager: "#jqGridPager"
        });
        $('#jqGrid').trigger('reloadGrid');
        $(document).resize();
    }

    $(function () {
        LoadItems();

        $('#custom-material-import-btn').on('click', function () {
            $('#custom-material-import-file').val('');
            $('#custom-material-import-file').click();
        });

        $('#custom-material-import-file').on('change', function () {
            var file = this.files && this.files.length ? this.files[0] : null;
            if (!file) {
                return;
            }
            var formData = new FormData();
            formData.append('file', file);
            formData.append('designTypeId', designTypeId);
            formData.append('lensIndexId', lensIndexId);
            $.ajax({
                url: '@Url.Action("ImportExcel", BasePage)',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false
            }).done(function (result) {
                var $errorBox = $('#custom-material-import-errors');
                $errorBox.addClass('d-none').html('');
                if (result && result.success) {
                    toastr.success("", result.message || '@ResourceAlert.AddSucces');
                    $errorBox.addClass('d-none').html('');
                    LoadItems();
                } else {
                    var message = result && result.message ? result.message : '@ResourceAlert.AddError';
                    toastr.error(message, '');
                    if (result && result.errors && result.errors.length) {
                        var html = '<div>' + escapeHtml(message) + '</div><ul class="mb-0">';
                        result.errors.forEach(function (e) {
                            html += '<li>' + escapeHtml(e) + '</li>';
                        });
                        html += '</ul>';
                        $errorBox.html(html).removeClass('d-none');
                    } else {
                        $errorBox.html('<div>' + escapeHtml(message) + '</div>').removeClass('d-none');
                    }
                }
            }).fail(function () { toastr.error('@ResourceAlert.AddError', '') });
        });

        $('#custom-material-export-btn').on('click', function () {
            var name = prompt('‰«„ ›«Ì· —« Ê«—œ ò‰Ìœ', 'CustomLensTypeMaterial');
            if (name === null) {
                return;
            }
            name = (name || '').trim();
            if (!name) {
                name = 'CustomLensTypeMaterial';
            }
            if (!name.toLowerCase().endsWith('.xlsx')) {
                name += '.xlsx';
            }
            var exportUrl = '@Url.Action("ExportExcel", BasePage)';
            fetch(exportUrl + '?designTypeId=' + designTypeId + '&lensIndexId=' + lensIndexId + embeddedQuery, { method: 'GET' })
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error('download failed');
                    }
                    return response.blob();
                })
                .then(function (blob) {
                    var url = window.URL.createObjectURL(blob);
                    var link = document.createElement('a');
                    link.href = url;
                    link.download = name;
                    document.body.appendChild(link);
                    link.click();
                    link.remove();
                    window.URL.revokeObjectURL(url);
                })
                .catch(function () { toastr.error('@ResourceAlert.AddError', '') });
        });

        function escapeHtml(value) {
            return (value || '').toString()
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/\"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

    });

</script>

