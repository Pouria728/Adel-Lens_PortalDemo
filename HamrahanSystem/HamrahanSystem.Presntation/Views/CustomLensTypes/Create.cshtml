@model HamrahanSystem.Application.DTOs.TblLnsLensTypeDto

@{
    ViewBag.Title = "";
    Layout = null;
    var brandId = ViewBag.BrandId ?? 0;
    var brandName = ViewBag.BrandName as string ?? string.Empty;
}

@using (Html.BeginForm("Create", "CustomLensTypes", FormMethod.Post, new { @id = "form-custom-lens-types-create" }))
{
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-header bg-warning" style="display:flex;justify-content:flex-end;direction:rtl;">
            <h2 class="card-title mb-0" style="margin:0 !important;text-align:right !important;">@ResourcePages.LensTypes</h2>
        </div>
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.LensTypeId)

            @if (brandId is int bid && bid > 0)
            {
                @Html.HiddenFor(model => model.BrandId)
                <div class="form-group row mb-6">
                    @Html.Label(ResourcePages.Brands, ResourcePages.Brands, htmlAttributes: new { @class = "col-lg-4 col-form-label required fw-semibold fs-6" })
                    <div class="col-md-4">
                        <input type="text" class="form-control form-control-lg form-control-solid" value="@brandName" readonly />
                    </div>
                </div>
            }
            else
            {
                <div class="form-group row mb-6">
                    @Html.Label(ResourcePages.Brands, ResourcePages.Brands, htmlAttributes: new { @class = "col-lg-4 col-form-label required fw-semibold fs-6" })
                    <div class="col-md-4">
                        @Html.DropDownListFor(model => model.BrandId, new MultiSelectList(ViewBag.ListBrand, "BrandId", "Name"), new { @class = "form-select form-select-solid form-select-lg", data_control = "select2", data_placeholder = "", data_dropdown_parent = "#modal-Tree" })
                    </div>
                </div>
            }

            <div class="form-group row mb-6">
                @Html.Label(ResourcePages.Base_Name, "عنوان Lens Type", htmlAttributes: new { @class = "col-lg-4 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control form-control-lg form-control-solid" } })
                </div>
            </div>

            <div class="form-group row mb-6">
                @Html.Label(ResourcePages.Base_Code, ResourcePages.Base_Code, htmlAttributes: new { @class = "col-lg-4 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.Code, new { htmlAttributes = new { @class = "form-control form-control-lg form-control-solid" } })
                </div>
            </div>

            <div class="form-group row mb-6">
                @Html.Label(ResourcePages.Base_Description, ResourcePages.Base_Description, htmlAttributes: new { @class = "col-lg-4 col-form-label fw-semibold fs-6" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control form-control-lg form-control-solid" } })
                </div>
            </div>

            <div class="form-group row mb-6">
                @Html.Label(ResourcePages.Base_OrderId, ResourcePages.Base_OrderId, htmlAttributes: new { @class = "col-lg-4 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.OrderId, new { htmlAttributes = new { @class = "form-control" } })
                </div>
            </div>

            <div class="form-group row mb-6">
                @Html.Label(ResourcePages.Base_IsActive, ResourcePages.Base_IsActive, htmlAttributes: new { @class = "col-lg-4 col-form-label required fw-semibold fs-6" })
                <div class="col-md-4">
                    <div class="checkbox">
                        @Html.CheckBoxFor(model => model.IsActive, htmlAttributes: new { @checked = true, @class = "form-check-input" })
                    </div>
                </div>
            </div>

            <div class="form-group row mb-6">
                @Html.Label("Corridor", "Corridor", htmlAttributes: new { @class = "col-lg-4 col-form-label fw-semibold fs-6" })
                <div class="col-md-4">
                    <div class="checkbox">
                        @Html.CheckBoxFor(model => model.IsCorridor, htmlAttributes: new { @class = "form-check-input" })
                    </div>
                </div>
            </div>

            <div class="form-group text-center mb-4">
                <input type="button" id="create-btn" value="@($"{ResourcePages.Save} {ResourcePages.LensTypes}")" class="btn btn-success" />
            </div>
        </div>
    </div>
}

<script type="text/javascript">

    $(function () {
        $(document).off("click", "#create-btn")
            .on("click", "#create-btn", function () {
                $form = $("#form-custom-lens-types-create");

                $.post('@Url.Action("Create", "CustomLensTypes")',
                    $form.serialize()
                )
                    .done(function (result) {
                        if (result.success) {
                            toastr.success("", '@ResourceAlert.AddSucces');
                            LoadItems();
                        } else {
                            toastr.error('@ResourceAlert.AddError', result.message);
                        }
                    }).fail(function () { toastr.error('@ResourceAlert.AddError', '') });
            });
    });

</script>
