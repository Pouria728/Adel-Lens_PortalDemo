<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\HamrahanSystem.Presntation.dll" stdoutLogEnabled="false" hostingModel="InProcess" stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
          <environmentVariable name="ConnectionStrings__PrintUrl" value="http://localhost:195" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering allowDoubleEscaping="true" />
      </security>
    </system.webServer>
  </location>
</configuration>
